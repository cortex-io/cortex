# Kubernetes Secret Template for Cortex
# DO NOT commit this file with real values!
#
# Usage:
#   1. Copy this template: cp secret.yaml.template secret.yaml
#   2. Replace <BASE64_ENCODED_VALUE> with actual base64-encoded secrets
#   3. Apply: kubectl apply -f secret.yaml
#   4. Add secret.yaml to .gitignore
#
# To encode a secret: echo -n "your-secret-value" | base64

apiVersion: v1
kind: Secret
metadata:
  name: cortex-secrets
  namespace: cortex
  labels:
    app.kubernetes.io/name: cortex
    app.kubernetes.io/component: secrets
type: Opaque
data:
  # Anthropic API Key (REQUIRED)
  # Example: echo -n "sk-ant-..." | base64
  ANTHROPIC_API_KEY: <BASE64_ENCODED_ANTHROPIC_KEY>

  # OpenAI API Key (OPTIONAL)
  # Example: echo -n "sk-..." | base64
  OPENAI_API_KEY: <BASE64_ENCODED_OPENAI_KEY>

  # GitHub Token for private repo access (OPTIONAL)
  # Example: echo -n "ghp_..." | base64
  GITHUB_TOKEN: <BASE64_ENCODED_GITHUB_TOKEN>

  # JWT Secret for dashboard authentication (OPTIONAL)
  # Example: echo -n "random-secret-string" | base64
  JWT_SECRET: <BASE64_ENCODED_JWT_SECRET>

  # MCP Server Credentials (OPTIONAL)
  N8N_MCP_TOKEN: <BASE64_ENCODED_N8N_TOKEN>
  PROXMOX_MCP_TOKEN: <BASE64_ENCODED_PROXMOX_TOKEN>

---
