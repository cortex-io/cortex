---
# Cortex Secrets Template
# DO NOT commit this file with real values!
# Use the create-secrets.sh script to generate secrets from environment variables
#
# Kubernetes Secrets are base64-encoded but NOT encrypted by default.
# For production, consider:
# - Sealed Secrets (bitnami-labs/sealed-secrets)
# - External Secrets Operator (external-secrets/external-secrets)
# - HashiCorp Vault
# - Cloud provider secret managers (AWS Secrets Manager, GCP Secret Manager, Azure Key Vault)

apiVersion: v1
kind: Secret
metadata:
  name: cortex-secrets
  namespace: cortex
  labels:
    app.kubernetes.io/name: cortex
    app.kubernetes.io/component: secrets
    app.kubernetes.io/part-of: cortex-automation
  annotations:
    description: "Cortex API keys and credentials"
    rotation-policy: "Rotate every 90 days"
    last-rotated: "YYYY-MM-DD"
type: Opaque
data:
  # Base64-encoded values - use: echo -n "value" | base64
  # To decode: echo "encoded" | base64 -d

  # Anthropic API Key (required)
  # Get from: https://console.anthropic.com/
  anthropic-api-key: <BASE64_ENCODED_ANTHROPIC_API_KEY>

  # GitHub Personal Access Token (required for PR/issue operations)
  # Scopes: repo, workflow, write:packages
  # Get from: https://github.com/settings/tokens
  github-token: <BASE64_ENCODED_GITHUB_TOKEN>

  # GitHub Container Registry Token (for private images)
  # Same as github-token or separate PAT
  ghcr-token: <BASE64_ENCODED_GHCR_TOKEN>

  # Proxmox API Token (optional, for Proxmox MCP operations)
  # Format: username@realm!tokenid=secret
  proxmox-api-token: <BASE64_ENCODED_PROXMOX_TOKEN>

  # OpenAI API Key (optional, for GPT models)
  openai-api-key: <BASE64_ENCODED_OPENAI_API_KEY>

---
# Separate Secret for sensitive Anthropic API key
# This allows more granular RBAC control
apiVersion: v1
kind: Secret
metadata:
  name: anthropic-api-key
  namespace: cortex
  labels:
    app.kubernetes.io/name: cortex
    app.kubernetes.io/component: secrets
  annotations:
    description: "Anthropic Claude API key"
    cost-center: "cortex-ai-operations"
type: Opaque
data:
  api-key: <BASE64_ENCODED_ANTHROPIC_API_KEY>

---
# GitHub Token Secret
apiVersion: v1
kind: Secret
metadata:
  name: github-token
  namespace: cortex
  labels:
    app.kubernetes.io/name: cortex
    app.kubernetes.io/component: secrets
  annotations:
    description: "GitHub API token for PR and repo operations"
type: Opaque
data:
  token: <BASE64_ENCODED_GITHUB_TOKEN>

---
# Docker Config Secret for GHCR
# For pulling private images from ghcr.io
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull-secret
  namespace: cortex
  labels:
    app.kubernetes.io/name: cortex
    app.kubernetes.io/component: secrets
  annotations:
    description: "Docker credentials for GitHub Container Registry"
type: kubernetes.io/dockerconfigjson
data:
  # Generate with:
  # kubectl create secret docker-registry ghcr-pull-secret \
  #   --docker-server=ghcr.io \
  #   --docker-username=<github-username> \
  #   --docker-password=<github-token> \
  #   --dry-run=client -o yaml
  .dockerconfigjson: <BASE64_ENCODED_DOCKER_CONFIG_JSON>
