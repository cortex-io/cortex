# Cortex Environment Variables Template
# Copy this to .env and fill in your actual values
# IMPORTANT: .env is gitignored and will NOT be committed

# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-api03-YOUR-KEY-HERE"
ANTHROPIC_API_URL="https://api.anthropic.com/v1"
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"
ANTHROPIC_DAILY_TOKEN_BUDGET="1000000"

# Proxmox VE API
PROXMOX_TOKEN="root@pam!YOUR-TOKEN-HERE"
PROXMOX_HOST="10.88.140.164"
PROXMOX_PORT="8006"
PROXMOX_NODE="pve01"
PROXMOX_API_BASE="https://10.88.140.164:8006/api2/json"

# K3s Cluster VMs (VLAN 145: 10.88.145.0/24)
K3S_MASTER_VMID="310"
K3S_MASTER_IP="10.88.145.180"

K3S_WORKER1_VMID="311"
K3S_WORKER1_IP="10.88.145.181"

K3S_WORKER2_VMID="312"
K3S_WORKER2_IP="10.88.145.182"

# GitHub Container Registry (for pulling images)
GITHUB_TOKEN="YOUR-GITHUB-TOKEN-HERE"

# Optional: n8n Workflow Automation
N8N_API_KEY="YOUR-N8N-KEY-HERE"
N8N_HOST="10.88.140.151"
N8N_PORT="5678"
