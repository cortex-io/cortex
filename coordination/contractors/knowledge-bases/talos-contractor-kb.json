    "orchestration_patterns": {
      "deploy_application": {
        "pattern_id": "deploy_application",
        "description": "Deploy containerized application to Kubernetes",
        "steps": [
          {
            "step": 1,
            "action": "create_namespace",
            "command": "kubectl create namespace <app-namespace>",
            "success_criteria": "Namespace created"
          },
          {
            "step": 2,
            "action": "apply_configmaps_secrets",
            "command": "kubectl apply -f configmaps/ -f secrets/",
            "success_criteria": "Configuration resources created"
          },
          {
            "step": 3,
            "action": "apply_deployment",
            "command": "kubectl apply -f deployment.yaml",
            "success_criteria": "Deployment created, pods starting"
          },
          {
            "step": 4,
            "action": "apply_service",
            "command": "kubectl apply -f service.yaml",
            "success_criteria": "Service created, endpoints ready"
          },
          {
            "step": 5,
            "action": "verify_deployment",
            "command": "kubectl rollout status deployment/<name>",
            "success_criteria": "All replicas available"
          }
        ],
        "complexity": 4,
        "success_rate": 0.93,
        "average_duration_minutes": 5
      },
      "deploy_monitoring_stack": {
        "pattern_id": "deploy_monitoring_stack",
        "description": "Deploy Prometheus and Grafana monitoring",
        "steps": [
          {
            "step": 1,
            "action": "add_helm_repo",
            "command": "helm repo add prometheus-community https://prometheus-community.github.io/helm-charts",
            "success_criteria": "Repo added"
          },
          {
            "step": 2,
            "action": "create_namespace",
            "command": "kubectl create namespace monitoring",
            "success_criteria": "Namespace created"
          },
          {
            "step": 3,
            "action": "install_prometheus",
            "command": "helm install prometheus prometheus-community/kube-prometheus-stack -n monitoring",
            "success_criteria": "Prometheus stack installed"
          },
          {
            "step": 4,
            "action": "verify_pods",
            "command": "kubectl get pods -n monitoring",
            "success_criteria": "All pods running"
          },
          {
            "step": 5,
            "action": "expose_grafana",
            "command": "kubectl port-forward svc/prometheus-grafana 3000:80 -n monitoring",
            "success_criteria": "Grafana accessible"
          }
        ],
        "complexity": 5,
        "success_rate": 0.90,
        "average_duration_minutes": 10
      },
      "rolling_update": {
        "pattern_id": "rolling_update",
        "description": "Perform rolling update with rollback capability",
        "steps": [
          {
            "step": 1,
            "action": "record_current_state",
            "command": "kubectl get deployment <name> -o yaml > backup.yaml",
            "success_criteria": "Current state saved"
          },
          {
            "step": 2,
            "action": "update_image",
            "command": "kubectl set image deployment/<name> <container>=<new-image>",
            "success_criteria": "Image updated, rollout started"
          },
          {
            "step": 3,
            "action": "monitor_rollout",
            "command": "kubectl rollout status deployment/<name>",
            "success_criteria": "Rollout progressing"
          },
          {
            "step": 4,
            "action": "verify_health",
            "method": "health_check_endpoints",
            "success_criteria": "Application healthy"
          },
          {
            "step": 5,
            "action": "rollback_if_failed",
            "command": "kubectl rollout undo deployment/<name> (if needed)",
            "success_criteria": "Rollback completed if triggered"
          }
        ],
        "complexity": 5,
        "success_rate": 0.91,
        "average_duration_minutes": 8,
        "rollback_strategy": "kubectl rollout undo or apply backup.yaml"
      },
      "scale_application": {
        "pattern_id": "scale_application",
        "description": "Scale application based on load",
        "steps": [
          {
            "step": 1,
            "action": "check_current_scale",
            "command": "kubectl get deployment <name>",
            "success_criteria": "Current replica count known"
          },
          {
            "step": 2,
            "action": "scale_deployment",
            "command": "kubectl scale deployment/<name> --replicas=<count>",
            "success_criteria": "Scale initiated"
          },
          {
            "step": 3,
            "action": "wait_for_pods",
            "command": "kubectl wait --for=condition=ready pod -l app=<label>",
            "success_criteria": "New pods ready"
          },
          {
            "step": 4,
            "action": "verify_service",
            "command": "kubectl get endpoints <service>",
            "success_criteria": "Endpoints updated"
          }
        ],
        "complexity": 3,
        "success_rate": 0.95,
        "average_duration_minutes": 3
      },
