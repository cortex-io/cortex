  "decision_trees": {
    "choose_deployment_method": {
      "description": "Select appropriate deployment method for workload",
      "root": {
        "question": "What type of application are you deploying?",
        "stateless_application": {
          "question": "Is it a packaged Helm chart?",
          "yes": {
            "decision": "use_helm_install",
            "confidence": 0.95,
            "reasoning": "Helm simplifies complex application deployment"
          },
          "no": {
            "decision": "use_kubectl_apply_with_manifests",
            "confidence": 0.92
          }
        },
        "stateful_application": {
          "question": "Do you need persistent storage?",
          "yes": {
            "decision": "use_statefulset_with_pvc",
            "confidence": 0.93,
            "components": ["StatefulSet", "PersistentVolumeClaim", "Service"]
          },
          "no": {
            "decision": "use_deployment_with_emptydir",
            "confidence": 0.88
          }
        },
        "batch_job": {
          "question": "Is it one-time or recurring?",
          "one_time": {
            "decision": "use_job_resource",
            "confidence": 0.94
          },
          "recurring": {
            "decision": "use_cronjob_resource",
            "confidence": 0.96
          }
        }
      }
    },
    "determine_scaling_strategy": {
      "description": "Choose scaling approach for application",
      "root": {
        "question": "What triggers scaling needs?",
        "predictable_load": {
          "question": "Is load time-based or event-based?",
          "time_based": {
            "decision": "use_manual_scaling_with_schedule",
            "confidence": 0.88
          },
          "event_based": {
            "decision": "use_keda_event_driven_autoscaling",
            "confidence": 0.85
          }
        },
        "variable_load": {
          "question": "What metrics drive scaling?",
          "cpu_memory": {
            "decision": "use_horizontal_pod_autoscaler",
            "confidence": 0.95,
            "config": {
              "minReplicas": 2,
              "maxReplicas": 10,
              "targetCPUUtilizationPercentage": 70
            }
          },
          "custom_metrics": {
            "decision": "use_hpa_with_custom_metrics",
            "confidence": 0.87,
            "requires": "metrics-server and custom metrics adapter"
          }
        },
        "manual_control": {
          "decision": "use_kubectl_scale",
          "confidence": 0.90,
          "reasoning": "Manual scaling for testing or specific scenarios"
        }
      }
    },
    "troubleshooting_strategy": {
      "description": "Systematic approach to troubleshooting K8s issues",
      "root": {
        "question": "What is the issue symptom?",
        "pod_not_starting": {
          "decision": "check_describe_and_events",
          "steps": [
            "kubectl describe pod",
            "Check Events for ImagePullBackOff, CrashLoopBackOff",
            "kubectl logs --previous",
            "Verify resource requests/limits"
          ],
          "confidence": 0.92
        },
        "service_not_accessible": {
          "decision": "verify_service_and_endpoints",
          "steps": [
            "kubectl get endpoints",
            "kubectl get svc",
            "Test pod-to-pod connectivity",
            "Check NetworkPolicies"
          ],
          "confidence": 0.89
        },
        "performance_issues": {
          "decision": "analyze_resource_usage",
          "steps": [
            "kubectl top pods",
            "kubectl top nodes",
            "Check HPA status",
            "Review application metrics"
          ],
          "confidence": 0.85
        }
      }
    }
