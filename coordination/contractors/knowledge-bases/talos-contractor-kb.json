  "common_pitfalls": [
    {
      "pitfall": "Not setting resource requests and limits",
      "impact": "Pod evictions, OOMKilled, scheduling issues",
      "prevention": "Always define requests and limits for CPU and memory"
    },
    {
      "pitfall": "Missing readiness probes",
      "impact": "Traffic to unhealthy pods, failed requests",
      "prevention": "Configure readiness and liveness probes for all containers"
    },
    {
      "pitfall": "Not using namespaces for isolation",
      "impact": "Resource conflicts, difficult RBAC management",
      "prevention": "Use namespaces to separate environments and applications"
    },
    {
      "pitfall": "Deploying without image pull policy",
      "impact": "Using cached old images instead of latest",
      "prevention": "Set imagePullPolicy: Always for :latest, IfNotPresent for versioned"
    },
    {
      "pitfall": "Not monitoring cluster resources",
      "impact": "Node exhaustion, degraded performance",
      "prevention": "Deploy monitoring stack early, set up alerts"
    }
  ],
