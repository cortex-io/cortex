  "test_scenarios": {
    "scenario_1_basic_accessibility": {
      "title": "Basic Dashboard Accessibility",
      "steps": [
        {
          "step": 1,
          "action": "Test HTTP connectivity to LoadBalancer IP",
          "command": "curl -I http://10.88.145.201/",
          "expected_result": "HTTP 200 response"
        },
        {
          "step": 2,
          "action": "Verify dashboard service exists",
          "command": "kubectl get svc dashboard -n cortex-system",
          "expected_result": "Service with external IP 10.88.145.201"
        },
        {
          "step": 3,
          "action": "Check service endpoints",
          "command": "kubectl get endpoints dashboard -n cortex-system",
          "expected_result": "At least one endpoint IP listed"
        }
      ]
    },
    "scenario_2_pod_health": {
      "title": "Pod Health Verification",
      "steps": [
        {
          "step": 1,
          "action": "List all cortex pods",
          "command": "kubectl get pods -n cortex-system",
          "expected_result": "5 pods in Running status"
        },
        {
          "step": 2,
          "action": "Check resource usage",
          "command": "kubectl top pods -n cortex-system",
          "expected_result": "CPU and memory within limits"
        },
        {
          "step": 3,
          "action": "Verify no high restart counts",
          "command": "kubectl get pods -n cortex-system -o jsonpath='{.items[*].status.containerStatuses[*].restartCount}'",
          "expected_result": "Values near 0"
        }
      ]
    },
    "scenario_3_api_health": {
      "title": "API Endpoints Health Check",
      "steps": [
        {
          "step": 1,
          "action": "Check API health",
          "command": "curl http://10.88.145.201:3004/api/health",
          "expected_result": "status: healthy"
        },
        {
          "step": 2,
          "action": "Get system metrics",
          "command": "curl http://10.88.145.201:3004/api/metrics",
          "expected_result": "Metrics object with active_workers, success_rate"
        },
        {
          "step": 3,
          "action": "Check dashboard summary",
          "command": "curl http://10.88.145.201:3004/api/dashboard/analytics/summary",
          "expected_result": "KPIs and trends data"
        }
      ]
    },
    "scenario_4_complete_cluster_health": {
      "title": "Complete Cluster Health Check",
      "steps": [
        {
          "step": 1,
          "action": "Run health check script",
          "command": "./scripts/monitoring/k3s-dashboard-health-check.sh",
          "expected_result": "All checks pass"
        },
        {
          "step": 2,
          "action": "Run verbose health check",
          "command": "./scripts/monitoring/k3s-dashboard-health-check.sh --verbose",
          "expected_result": "Detailed output of all checks"
        },
        {
          "step": 3,
          "action": "Generate JSON report",
          "command": "./scripts/monitoring/k3s-dashboard-health-check.sh --output json",
          "expected_result": "JSON report at /tmp/k3s-health-check-report.json"
        }
      ]
    }
  },
