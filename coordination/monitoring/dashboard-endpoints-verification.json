  "troubleshooting_guide": {
    "issue_no_external_ip": {
      "symptom": "External IP shows '<pending>'",
      "causes": [
        "MetalLB not installed",
        "No available IPs in MetalLB range",
        "Service not properly configured"
      ],
      "solutions": [
        "Check MetalLB installation: kubectl get pods -n metallb-system",
        "Verify MetalLB ConfigMap: kubectl get configmap -n metallb-system",
        "Check service: kubectl describe svc dashboard -n cortex-system"
      ]
    },
    "issue_no_endpoints": {
      "symptom": "Service has no endpoints (empty ENDPOINTS column)",
      "causes": [
        "No running pods with correct labels",
        "Selector mismatch in service",
        "Pod in CrashLoopBackOff state"
      ],
      "solutions": [
        "Check pod status: kubectl get pods -n cortex-system",
        "Verify service selector: kubectl get svc dashboard -n cortex-system -o yaml | grep -A2 selector",
        "Check pod logs: kubectl logs <pod-name> -n cortex-system"
      ]
    },
    "issue_connection_refused": {
      "symptom": "Connection refused when accessing http://10.88.145.201/",
      "causes": [
        "Pod not listening on correct port",
        "Service targeting wrong port",
        "Network policy blocking traffic"
      ],
      "solutions": [
        "Port forward for testing: kubectl port-forward svc/dashboard 8080:80 -n cortex-system",
        "Check pod is running: kubectl get pods -n cortex-system",
        "Verify service ports: kubectl get svc dashboard -n cortex-system -o yaml"
      ]
    }
  }
