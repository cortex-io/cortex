        "task_id": "scaling-001",
        "title": "Install and configure KEDA operator",
        "type": "k8s_deployment",
        "complexity": 5,
        "deliverables": [
          {
            "file": "k8s/keda/keda-install.sh",
            "description": "Script to install KEDA via Helm",
            "requirements": [
              "Install Helm if not present",
              "Add KEDA Helm repo: helm repo add kedacore https://kedacore.github.io/charts",
              "Install KEDA: helm install keda kedacore/keda --namespace keda --create-namespace",
              "Verify KEDA operator is running",
              "Check KEDA metrics server is healthy"
            ]
          },
          {
            "file": "k8s/keda/keda-config.yaml",
            "description": "KEDA configuration (if needed)",
            "requirements": [
              "Configure Prometheus scaler address",
              "Set default polling interval: 30s",
              "Configure cooldown period: 300s"
            ]
          }
        ]
      },
      {
        "task_id": "scaling-002",
        "title": "Create worker deployment manifests with resource limits",
        "type": "k8s_manifests",
        "complexity": 8,
        "deliverables": [
          {
            "file": "k8s/workers/implementation-worker-deployment.yaml",
            "description": "Implementation worker deployment",
            "requirements": [
              "Deployment with 0 initial replicas",
              "Container: ghcr.io/ry-ops/cortex-docker:latest",
              "Command: ['./scripts/spawn-worker.sh', '--type', 'implementation-worker']",
              "Resource requests: 250m CPU, 512Mi memory",
              "Resource limits: 1000m CPU, 2Gi memory",
              "Shared PVC for coordination files (ReadWriteMany)",
              "Environment variables from ConfigMap",
              "Liveness/readiness probes"
            ]
          },
          {
            "file": "k8s/workers/security-worker-deployment.yaml",
            "description": "Security worker deployment",
            "requirements": [
              "Same as implementation worker",
              "Command: ['./scripts/spawn-worker.sh', '--type', 'scan-worker']",
              "Labels: worker-type=security"
            ]
          },
          {
            "file": "k8s/workers/analysis-worker-deployment.yaml",
            "description": "Analysis worker deployment",
            "requirements": [
              "Same as implementation worker",
              "Command: ['./scripts/spawn-worker.sh', '--type', 'analysis-worker']",
              "Labels: worker-type=analysis"
            ]
          },
          {
            "file": "k8s/workers/scan-worker-deployment.yaml",
            "description": "Scan worker deployment",
            "requirements": [
              "Same as implementation worker",
              "Command: ['./scripts/spawn-worker.sh', '--type', 'scan-worker']",
              "Labels: worker-type=scan"
            ]
          }
        ]
      },
      {
        "task_id": "scaling-003",
        "title": "Create KEDA ScaledObjects for queue-based scaling",
        "type": "k8s_manifests",
        "complexity": 9,
        "deliverables": [
          {
            "file": "k8s/keda/scaledobject-implementation.yaml",
            "description": "ScaledObject for implementation workers",
            "requirements": {
              "apiVersion": "keda.sh/v1alpha1",
              "kind": "ScaledObject",
              "spec": {
                "scaleTargetRef": {
                  "name": "implementation-worker"
                },
                "minReplicaCount": 0,
                "maxReplicaCount": 50,
                "pollingInterval": 30,
                "cooldownPeriod": 300,
                "triggers": [
                  {
                    "type": "prometheus",
                    "metadata": {
                      "serverAddress": "http://prometheus:9090",
                      "metricName": "cortex_task_queue_depth",
                      "query": "cortex_task_queue_depth{type=\"implementation\"}",
                      "threshold": "1"
                    }
                  }
                ],
                "advanced": {
                  "horizontalPodAutoscalerConfig": {
                    "behavior": {
                      "scaleDown": {
                        "stabilizationWindowSeconds": 300,
                        "policies": [
                          {
                            "type": "Percent",
                            "value": 50,
                            "periodSeconds": 60
                          }
                        ]
                      },
                      "scaleUp": {
                        "stabilizationWindowSeconds": 0,
                        "policies": [
                          {
                            "type": "Percent",
                            "value": 100,
                            "periodSeconds": 15
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "file": "k8s/keda/scaledobject-security.yaml",
            "description": "ScaledObject for security workers",
            "requirements": "Same structure, query: cortex_task_queue_depth{type=\"security\"}"
          },
          {
            "file": "k8s/keda/scaledobject-analysis.yaml",
            "description": "ScaledObject for analysis workers",
            "requirements": "Same structure, query: cortex_task_queue_depth{type=\"analysis\"}"
          },
          {
            "file": "k8s/keda/scaledobject-scan.yaml",
            "description": "ScaledObject for scan workers",
            "requirements": "Same structure, query: cortex_task_queue_depth{type=\"scan\"}"
          }
        ]
      },
      {
        "task_id": "scaling-004",
        "title": "Create master StatefulSet manifests (stateful, single replica)",
        "type": "k8s_manifests",
        "complexity": 7,
        "deliverables": [
