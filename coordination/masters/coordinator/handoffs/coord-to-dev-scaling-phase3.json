          },
          {
            "file": "k8s/masters/development-statefulset.yaml",
            "description": "Development master StatefulSet",
            "requirements": "Same as coordinator, command: ['./scripts/run-development-master.sh']"
          },
          {
            "file": "k8s/masters/security-statefulset.yaml",
            "description": "Security master StatefulSet",
            "requirements": "Same as coordinator, command: ['./scripts/run-security-master.sh']"
          },
          {
            "file": "k8s/masters/cicd-statefulset.yaml",
            "description": "CI/CD master StatefulSet",
            "requirements": "Same as coordinator, command: ['./scripts/run-cicd-master.sh']"
          },
          {
            "file": "k8s/masters/inventory-statefulset.yaml",
            "description": "Inventory master StatefulSet",
            "requirements": "Same as coordinator, command: ['./scripts/run-inventory-master.sh']"
          }
        ]
      },
      {
        "task_id": "scaling-005",
        "title": "Create shared PVC for coordination files (ReadWriteMany)",
        "type": "k8s_manifests",
        "complexity": 6,
        "deliverables": [
          {
            "file": "k8s/storage/coordination-pvc.yaml",
            "description": "PVC for shared coordination directory",
            "requirements": [
              "accessMode: ReadWriteMany (required for multi-pod access)",
              "storage: 20Gi",
              "storageClass: Use NFS or similar RWX-capable storage",
              "mountPath: /app/coordination in all pods"
            ]
          },
          {
            "file": "k8s/storage/nfs-provisioner.yaml",
            "description": "NFS provisioner for RWX storage (if not available)",
            "requirements": [
              "Deploy NFS server pod",
              "Create StorageClass for NFS",
              "Configure PV/PVC provisioning",
              "Note: This is K3s-specific, use local-path by default"
            ]
          },
          {
            "file": "docs/storage-options.md",
            "description": "Documentation on storage choices",
            "requirements": [
              "Explain ReadWriteMany requirement",
              "Document NFS setup for K3s",
              "Alternative: HostPath with NodeAffinity (single node)",
              "Production recommendation: Use Longhorn or NFS"
            ]
          }
        ]
      }
    ]
  },

  "context": {
    "keda_scaling_logic": {
      "scale_up": {
        "condition": "cortex_task_queue_depth > 0",
        "action": "Spawn workers immediately (100% increase per 15s)",
        "max_workers": 50
      },
      "scale_down": {
        "condition": "cortex_task_queue_depth == 0 for 5 minutes",
        "action": "Scale down 50% per minute",
        "min_workers": 0
      },
      "scale_to_zero": {
        "enabled": true,
        "cooldown": "5 minutes after last task",
        "benefit": "Cost savings when idle"
      }
    },
    "storage_challenge": {
      "issue": "K3s default storage (local-path) is ReadWriteOnce",
      "requirement": "Coordination files need ReadWriteMany for multi-pod access",
      "solutions": [
        "Option 1: Deploy NFS server in cluster (simple, but single point of failure)",
        "Option 2: Use Longhorn (distributed storage, production-ready)",
        "Option 3: HostPath with NodeAffinity (pin all pods to one node)",
        "Recommended": "Start with HostPath+NodeAffinity for POC, add Longhorn for production"
      ]
    },
    "anti_affinity_strategy": {
      "masters": "Prefer different nodes (soft anti-affinity)",
      "workers": "No anti-affinity (pack tightly for resource efficiency)",
      "reason": "Masters need high availability, workers are ephemeral"
    }
  },

