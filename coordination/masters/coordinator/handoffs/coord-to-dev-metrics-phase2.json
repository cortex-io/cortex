    "bundle_name": "Cortex Metrics & Prometheus/Grafana Monitoring Stack",
    "tasks": [
      {
        "task_id": "metrics-001",
        "title": "Implement Cortex /metrics endpoint with Prometheus exporter",
        "type": "feature_development",
        "complexity": 8,
        "deliverables": [
          {
            "file": "dashboard/server/metrics-exporter.js",
            "description": "Express middleware to expose Prometheus metrics",
            "requirements": [
              "Use prom-client npm package",
              "Expose /metrics endpoint on port 3000",
              "Implement all required metrics (see metrics_schema)",
              "Update metrics from coordination files every 15 seconds",
              "Include default Node.js metrics (heap, cpu, etc.)"
            ],
            "metrics_schema": {
              "cortex_task_queue_depth": {
                "type": "Gauge",
                "help": "Current task queue depth by type",
                "labels": ["type"],
                "source": "coordination/task-queue.json",
                "calculation": "Count tasks by type where status != 'completed'"
              },
              "cortex_active_workers": {
                "type": "Gauge",
                "help": "Currently active workers by type",
                "labels": ["type", "status"],
                "source": "coordination/worker-pool.json",
                "calculation": "Count workers where status == 'running'"
              },
              "cortex_master_health": {
                "type": "Gauge",
                "help": "Master health status (1=healthy, 0=unhealthy)",
                "labels": ["master"],
                "source": "coordination/masters/*/context/master-state.json",
                "calculation": "Check last_heartbeat < 60s ago"
              },
              "cortex_task_duration_seconds": {
                "type": "Histogram",
                "help": "Task completion time in seconds",
                "labels": ["type", "status"],
                "source": "coordination/task-queue.json",
                "calculation": "completed_at - assigned_at",
                "buckets": [1, 5, 10, 30, 60, 120, 300, 600]
              },
              "cortex_moe_routing_confidence": {
                "type": "Gauge",
                "help": "MoE routing confidence score",
                "labels": ["from_master", "to_master"],
                "source": "coordination/masters/coordinator/knowledge-base/routing-decisions.jsonl",
                "calculation": "Latest routing confidence by master pair"
              },
              "cortex_worker_spawn_rate": {
                "type": "Counter",
                "help": "Total worker spawns",
                "labels": ["type"]
              },
              "cortex_task_success_rate": {
                "type": "Gauge",
                "help": "Task success rate (0-1)",
                "labels": ["type"],
                "calculation": "successful_tasks / total_tasks (last 1h)"
              }
            }
          },
          {
            "file": "lib/observability/prometheus-metrics.sh",
            "description": "Bash library to update metrics from shell scripts",
            "requirements": [
              "Functions to increment counters",
              "Functions to set gauge values",
              "Write to metrics temp file for collection",
              "Thread-safe updates using file locks"
            ]
          },
          {
            "file": "docs/metrics-schema.md",
            "description": "Complete metrics documentation",
            "requirements": [
              "Document all metrics with examples",
              "Include PromQL query examples",
              "Document label values",
              "Include alerting rule recommendations"
            ]
          }
