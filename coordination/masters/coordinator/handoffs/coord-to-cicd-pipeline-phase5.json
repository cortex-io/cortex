                "secrets_required": [
                  "KUBE_CONFIG_DATA (base64 kubeconfig)",
                  "ANTHROPIC_API_KEY",
                  "PROXMOX_TOKEN_VALUE"
                ]
              },
              {
                "name": "rollback-on-failure",
                "condition": "if: failure()",
                "steps": [
                  "Rollback to previous deployment",
                  "Notify team of failure",
                  "Create incident issue"
                ]
              }
            ]
          },
