              },
              {
                "name": "deploy-to-k3s",
                "steps": [
                  "Configure kubectl with K3s context",
                  "Update image tag in manifests",
                  "Apply K8s manifests (kubectl apply -f k8s/)",
                  "Wait for rollout to complete",
                  "Run smoke tests",
                  "Notify deployment status"
