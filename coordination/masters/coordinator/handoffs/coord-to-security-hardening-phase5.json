  "task_bundle": {
    "bundle_name": "Security Hardening and RBAC Configuration",
    "tasks": [
      {
        "task_id": "security-001",
        "title": "Implement Kubernetes RBAC policies",
        "type": "security_configuration",
        "complexity": 7,
        "deliverables": [
          {
            "file": "k8s/security/rbac.yaml",
            "description": "RBAC configuration for Cortex",
            "requirements": [
              "ServiceAccount for cortex-master",
              "ServiceAccount for cortex-worker",
              "Role for masters: read/write coordination ConfigMaps/Secrets",
              "Role for workers: read coordination ConfigMaps",
              "ClusterRole for Prometheus: list/watch pods, services, endpoints",
              "RoleBindings and ClusterRoleBindings",
              "Principle of least privilege"
            ]
          },
          {
            "file": "k8s/security/pod-security-standards.yaml",
            "description": "Pod Security Standards enforcement",
            "requirements": [
              "Enforce restricted Pod Security Standard",
              "No privileged containers",
              "No host network/PID/IPC",
              "Read-only root filesystem where possible",
              "Non-root user (UID 1000)",
              "Drop all capabilities",
              "SeccompProfile: RuntimeDefault"
            ]
          }
        ]
      },
      {
        "task_id": "security-002",
        "title": "Implement network policies",
        "type": "security_configuration",
        "complexity": 6,
        "deliverables": [
          {
            "file": "k8s/security/network-policies.yaml",
            "description": "Network segmentation policies",
            "requirements": [
              "Default deny all ingress",
              "Allow masters to communicate with each other",
              "Allow workers to read from masters",
              "Allow Prometheus to scrape all pods",
              "Allow Grafana to query Prometheus",
              "Deny external ingress except NodePort services",
              "Document policy intent with annotations"
            ]
          }
        ]
      },
      {
        "task_id": "security-003",
        "title": "Container image security scanning",
        "type": "security_audit",
        "complexity": 5,
        "deliverables": [
          {
            "file": "security/reports/cortex-docker-image-scan.md",
            "description": "Container vulnerability scan report",
            "requirements": [
              "Scan ghcr.io/ry-ops/cortex-docker:latest with Trivy",
              "Report critical and high vulnerabilities",
              "Check for secrets in image layers",
              "Verify base image is up-to-date",
              "Recommend fixes for findings"
            ]
          }
        ]
      },
      {
        "task_id": "security-004",
        "title": "Secrets management audit",
        "type": "security_audit",
        "complexity": 6,
        "deliverables": [
          {
            "file": "docs/security/secrets-management.md",
            "description": "Secrets management strategy",
            "requirements": [
              "Document secret rotation procedures",
              "Recommend external secrets operator (e.g., External Secrets Operator)",
              "Document encryption at rest (K8s secrets are base64, not encrypted)",
              "Recommend Sealed Secrets or Vault for production",
              "Audit existing secrets for compliance"
            ]
          },
          {
            "file": "k8s/security/sealed-secrets-setup.yaml",
            "description": "Sealed Secrets installation (optional)",
            "requirements": [
              "Install Sealed Secrets controller",
              "Create SealedSecret for ANTHROPIC_API_KEY",
              "Document sealing procedure",
              "Note: Optional enhancement for production"
            ]
          }
        ]
      },
