        "title": "Create orchestration script for VM deployment and K3s bootstrap",
        "type": "orchestration",
        "complexity": 6,
        "dependencies": ["infra-001", "infra-002"],
        "deliverables": [
          {
            "file": "scripts/deploy/bootstrap-k3s-cluster.sh",
            "description": "End-to-end cluster deployment orchestration",
            "requirements": [
              "Create 3 VMs on Proxmox (110, 111, 112)",
              "Wait for cloud-init completion on all VMs",
              "Install K3s control plane on VM 110",
              "Join workers 111 and 112 to cluster",
              "Verify cluster health",
              "Export kubeconfig to local machine",
              "Print access instructions"
            ]
          }
        ]
      }
    ]
