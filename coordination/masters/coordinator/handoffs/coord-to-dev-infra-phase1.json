              "Install K3s with --write-kubeconfig-mode 644",
              "Disable Traefik (we'll use our own ingress)",
              "Configure for Flannel CNI",
              "Export K3s token for worker joins",
              "Verify apiserver health",
              "Generate kubeconfig for external access"
            ]
          },
          {
            "file": "scripts/k3s/join-worker.sh",
            "description": "Join worker nodes to K3s cluster",
            "requirements": [
              "Accept parameters: worker_ip, control_plane_ip, k3s_token",
              "Install K3s in agent mode",
              "Configure node labels for worker type",
              "Verify node join successful",
              "Wait for node Ready status"
            ]
          },
          {
            "file": "scripts/k3s/verify-cluster.sh",
            "description": "Verify K3s cluster health",
            "requirements": [
              "Check all nodes are Ready",
              "Verify system pods running",
              "Test kubectl connectivity",
              "Validate CoreDNS is healthy",
              "Output cluster status report"
            ]
          }
        ]
      },
      {
