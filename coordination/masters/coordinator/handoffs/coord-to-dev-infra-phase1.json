              "Verify connectivity before proceeding"
            ]
          },
          {
            "file": "scripts/proxmox/cloud-init-template.yaml",
            "description": "Cloud-init template for VM initialization",
            "requirements": [
              "Install required packages: curl, wget, apt-transport-https",
              "Configure SSH access with public key",
              "Set hostname and network config",
              "Disable password authentication",
              "Enable unattended security updates"
            ]
          }
        ]
      },
