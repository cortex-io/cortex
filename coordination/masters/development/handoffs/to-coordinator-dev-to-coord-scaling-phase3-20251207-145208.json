  "technical_implementation": {
    "keda_configuration": {
      "scale_up_behavior": {
        "stabilization_window": "0s (immediate)",
        "policies": [
          "100% increase every 15s",
          "OR +10 pods (whichever is higher)"
        ],
        "example": "0→10→20→40 pods in 45 seconds"
      },
      "scale_down_behavior": {
        "stabilization_window": "60s",
        "policies": [
          "50% decrease every 60s",
          "OR -5 pods (whichever is lower)"
        ],
        "cooldown": "5 minutes before scale-to-zero"
      },
      "prometheus_triggers": {
        "metric": "cortex_task_queue_depth",
        "query": "sum(cortex_task_queue_depth{type=\"<worker-type>\"}) or vector(0)",
        "threshold": 2
      }
    },
    "statefulset_design": {
      "masters": {
        "replicas": 1,
        "never_scale": true,
        "persistent_storage": "10Gi per master",
        "shared_storage": "50Gi coordination volume",
        "anti_affinity": "preferredDuringSchedulingIgnoredDuringExecution"
      }
    },
    "worker_design": {
      "stateless": true,
      "initial_replicas": 0,
      "graceful_shutdown": {
        "timeout": "300s",
        "behavior": "Finish current task, then exit",
        "signal": "SIGTERM"
      },
      "task_processing": {
        "mode": "file-based queue",
        "claim_mechanism": "atomic rename .json -> .processing.json",
        "completion_tracking": "task-results/*.json"
      }
    },
    "mode_detection": {
      "entry_point": "index.js",
      "environment_variables": {
        "CORTEX_MODE": "master | worker",
        "CORTEX_TYPE": "<specific-type>"
      },
      "master_script_mapping": {
        "coordinator": "/app/scripts/run-coordinator-master.sh",
