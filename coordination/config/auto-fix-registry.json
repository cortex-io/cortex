    {
      "fix_id": "fix_increase_memory_for_oom",
      "category": "resource",
      "name": "Increase Memory Limit for OOM",
      "description": "Increases worker memory limit when out-of-memory patterns detected",
      "applies_to_patterns": [
        "resource:out_of_memory",
        "resource:memory_exhausted"
      ],
      "prerequisites": {
        "min_pattern_confidence": 0.80,
        "min_pattern_occurrences": 3,
        "requires_worker_specs": true,
        "max_memory_limit_mb": 8192
      },
      "safety": {
        "safety_score": 0.95,
        "requires_approval": false,
        "rollback_supported": true,
        "reversible": true,
        "risk_level": "low"
      },
      "actions": [
        {
          "type": "modify_worker_spec",
          "field": "resources.memory_limit_mb",
          "operation": "multiply",
          "value": 1.5,
          "max_value": 8192
        }
      ],
      "validation": {
        "monitoring_period_hours": 24,
        "success_criteria": [
          {
            "type": "pattern_occurrence_decrease",
            "min_decrease_percent": 50,
            "measurement_window_hours": 24
          },
          {
            "type": "worker_success_rate",
            "min_success_rate": 0.80
          }
        ]
      },
      "rollback": {
        "type": "restore_previous_config",
        "conditions": [
          {
            "type": "validation_failure",
            "action": "immediate"
          },
          {
            "type": "new_failures_detected",
            "threshold": 3,
            "action": "immediate"
          }
        ]
      }
    },
