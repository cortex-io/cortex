{
  "widget_id": "n8n-mcp-server-metrics",
  "widget_type": "integration_monitor",
  "title": "n8n MCP Server",
  "description": "Real-time monitoring of n8n workflow automation via MCP",
  "category": "integrations",
  "priority": 1,
  "layout": {
    "grid_position": {
      "row": 2,
      "column": 1,
      "width": 6,
      "height": 4
    },
    "refresh_interval": 60,
    "auto_refresh": true
  },
  "data_sources": {
    "health_check": {
      "source": "file",
      "path": "coordination/monitoring/n8n-health-report.json",
      "refresh_interval": 60,
      "fallback": {
        "status": "unknown",
        "message": "No health data available"
      }
    },
    "workflow_metrics": {
      "source": "file",
      "path": "coordination/monitoring/n8n-workflow-metrics.json",
      "refresh_interval": 300
    },
    "execution_metrics": {
      "source": "file",
      "path": "coordination/monitoring/n8n-execution-metrics.json",
      "refresh_interval": 300
    },
    "security_status": {
      "source": "file",
      "path": "coordination/integrations/n8n-mcp-server/security/reports/latest-scan.json",
      "refresh_interval": 3600,
      "optional": true
    }
  },
  "visualizations": [
    {
      "type": "status_indicator",
      "title": "Health Status",
      "data_source": "health_check",
      "field": "status",
      "mapping": {
        "healthy": {
          "color": "green",
          "icon": "check-circle",
          "label": "Healthy"
        },
        "degraded": {
          "color": "yellow",
          "icon": "exclamation-triangle",
          "label": "Degraded"
        },
        "unhealthy": {
          "color": "red",
          "icon": "times-circle",
          "label": "Unhealthy"
        },
        "unknown": {
          "color": "gray",
          "icon": "question-circle",
          "label": "Unknown"
        }
      }
    },
    {
      "type": "metrics_grid",
      "title": "Workflow Metrics",
      "data_source": "workflow_metrics",
      "metrics": [
        {
          "label": "Total Workflows",
          "field": "total_workflows",
          "format": "number",
          "trend": true
        },
        {
          "label": "Active Workflows",
          "field": "active_workflows",
          "format": "number",
          "color": "green"
        },
        {
          "label": "Inactive Workflows",
          "field": "inactive_workflows",
          "format": "number",
          "color": "gray"
        }
      ]
    },
    {
      "type": "metrics_grid",
      "title": "Execution Metrics",
      "data_source": "execution_metrics",
      "metrics": [
        {
          "label": "Total Executions",
          "field": "total_executions",
          "format": "number",
          "description": "Last 50 executions"
        },
        {
          "label": "Success Rate",
          "field": "success_executions",
          "format": "percentage",
          "calculate": "success_executions / total_executions * 100",
          "color": "green",
          "threshold": {
            "good": 95,
            "warning": 80,
            "critical": 60
          }
        },
        {
          "label": "Failure Rate",
          "field": "failure_rate",
          "format": "percentage",
          "color": "red",
          "threshold": {
            "good": 5,
            "warning": 20,
            "critical": 40
          }
        },
        {
          "label": "Failed Executions",
          "field": "failed_executions",
          "format": "number",
          "color": "red"
        }
      ]
    },
    {
      "type": "chart",
      "chart_type": "line",
      "title": "Execution Trends",
      "data_source": "execution_metrics",
      "time_series": true,
      "fields": [
        {
          "name": "success_executions",
          "label": "Success",
          "color": "green"
        },
        {
          "name": "failed_executions",
          "label": "Failed",
          "color": "red"
        }
      ],
      "time_range": "24h"
    },
    {
      "type": "status_badge",
      "title": "Security Status",
      "data_source": "security_status",
      "field": "overall_status",
      "show_counts": true,
      "severity_counts": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    {
      "type": "alert_list",
      "title": "Recent Alerts",
      "data_source": "health_check",
      "fields": {
        "warnings": "warnings",
        "errors": "errors"
      },
      "max_items": 5,
      "show_timestamp": true
    }
  ],
  "actions": [
    {
      "id": "run_health_check",
      "label": "Run Health Check",
      "icon": "heartbeat",
      "type": "script",
      "script": "coordination/integrations/n8n-mcp-server/monitoring/n8n-health-check.sh",
      "confirm": false,
      "reload_after": true
    },
    {
      "id": "view_workflows",
      "label": "View n8n Workflows",
      "icon": "workflow",
      "type": "link",
      "url": "http://10.88.140.149:5678/workflows",
      "target": "_blank"
    },
    {
      "id": "view_executions",
      "label": "View Executions",
      "icon": "list",
      "type": "link",
      "url": "http://10.88.140.149:5678/executions",
      "target": "_blank"
    },
    {
      "id": "run_security_scan",
      "label": "Run Security Scan",
      "icon": "shield",
      "type": "task",
      "task_config": "coordination/integrations/n8n-mcp-server/security/n8n-security-scan.json",
      "confirm": true
    },
    {
      "id": "view_logs",
      "label": "View Logs",
      "icon": "file-text",
      "type": "modal",
      "content_source": "docker_logs",
      "container": "n8n-mcp-server",
      "lines": 100
    }
  ],
  "alerts": {
    "enabled": true,
    "rules": [
      {
        "id": "unhealthy_status",
        "condition": "health_check.status == 'unhealthy'",
        "severity": "critical",
        "message": "n8n MCP Server is unhealthy",
        "notification": true
      },
      {
        "id": "high_failure_rate",
        "condition": "execution_metrics.failure_rate > 20",
        "severity": "warning",
        "message": "High execution failure rate detected",
        "notification": true
      },
      {
        "id": "no_active_workflows",
        "condition": "workflow_metrics.active_workflows == 0",
        "severity": "info",
        "message": "No active workflows running"
      },
      {
        "id": "security_vulnerabilities",
        "condition": "security_status.critical > 0 || security_status.high > 0",
        "severity": "high",
        "message": "Security vulnerabilities detected",
        "notification": true
      }
    ]
  },
  "integration": {
    "repository": "https://github.com/ry-ops/n8n-mcp-server",
    "documentation": "docs/integrations/n8n-mcp-server-integration.md",
    "config_file": "coordination/integrations/n8n-mcp-server/config/n8n-config.json",
    "health_check_script": "coordination/integrations/n8n-mcp-server/monitoring/n8n-health-check.sh",
    "security_scan_config": "coordination/integrations/n8n-mcp-server/security/n8n-security-scan.json"
  },
  "metadata": {
    "created_at": "2025-12-13T00:00:00Z",
    "created_by": "development-master",
    "version": "1.0.0",
    "last_updated": "2025-12-13T00:00:00Z",
    "cortex_integration": true,
    "mcp_server": true
  }
}
