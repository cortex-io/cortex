{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Commit-Relay Metrics Schema",
  "description": "Unified metrics schema for time-series data collection",
  "type": "object",
  "required": ["metric_id", "timestamp", "metric_name", "metric_type", "value"],
  "properties": {
    "metric_id": {
      "type": "string",
      "description": "Unique identifier for this metric sample",
      "pattern": "^metric-[a-z0-9-]+$"
    },
    "timestamp": {
      "type": "integer",
      "description": "Unix timestamp in milliseconds",
      "minimum": 0
    },
    "metric_name": {
      "type": "string",
      "description": "Name of the metric",
      "pattern": "^[a-z_][a-z0-9_]*$",
      "examples": [
        "task_queue_depth",
        "worker_spawn_time_ms",
        "master_routing_confidence",
        "system_token_budget_remaining"
      ]
    },
    "metric_type": {
      "type": "string",
      "description": "Type of metric",
      "enum": ["counter", "gauge", "histogram", "summary"]
    },
    "value": {
      "type": "number",
      "description": "Metric value"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement",
      "enum": [
        "count",
        "milliseconds",
        "seconds",
        "bytes",
        "percentage",
        "ratio",
        "tokens",
        "workers",
        "tasks"
      ]
    },
    "dimensions": {
      "type": "object",
      "description": "Dimensional tags for filtering and grouping",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "worker_id": {
          "type": "string"
        },
        "master_id": {
          "type": "string"
        },
        "master_type": {
          "type": "string",
          "enum": ["coordinator", "development", "security", "inventory", "cicd"]
        },
        "worker_type": {
          "type": "string",
          "enum": ["scan", "implementation", "documentation", "analysis"]
        },
        "task_type": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "status": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "source": {
          "type": "string",
          "description": "Component that collected this metric"
        },
        "trace_id": {
          "type": "string",
          "description": "Associated trace ID if applicable"
        },
        "aggregation_window": {
          "type": "string",
          "description": "For aggregated metrics (1m, 5m, 1h, 1d)"
        }
      },
      "additionalProperties": true
    },
    "aggregates": {
      "type": "object",
      "description": "Aggregated values for histograms/summaries",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sum": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "mean": {
          "type": "number"
        },
        "median": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        },
        "p99": {
          "type": "number"
        },
        "stddev": {
          "type": "number"
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "metric_categories": {
      "task_metrics": {
        "queue_depth": "Number of tasks in queue",
        "routing_time_ms": "Time to route task to master",
        "execution_time_ms": "Task execution duration",
        "success_rate": "Task success rate (0-1)",
        "failure_rate": "Task failure rate (0-1)",
        "completion_rate": "Tasks completed per minute",
        "retry_count": "Number of retries",
        "timeout_rate": "Task timeout rate (0-1)"
      },
      "worker_metrics": {
        "spawn_time_ms": "Worker spawn duration",
        "token_usage": "Tokens consumed by worker",
        "token_rate": "Tokens per second",
        "completion_rate": "Workers completed per minute",
        "failure_rate": "Worker failure rate (0-1)",
        "active_count": "Currently active workers",
        "idle_time_ms": "Worker idle time",
        "cpu_usage_percent": "Worker CPU usage",
        "memory_bytes": "Worker memory consumption"
      },
      "master_metrics": {
        "routing_confidence": "Master routing confidence (0-1)",
        "decision_time_ms": "Time to make routing decision",
        "success_rate": "Master success rate (0-1)",
        "utilization_rate": "Master utilization (0-1)",
        "queue_depth": "Tasks queued for master",
        "throughput": "Tasks per minute"
      },
      "system_metrics": {
        "token_budget_remaining": "Available token budget",
        "token_burn_rate": "Tokens consumed per minute",
        "active_workers": "Total active workers",
        "active_masters": "Total active masters",
        "queue_age_ms": "Age of oldest queued task",
        "system_load": "System load average",
        "disk_usage_bytes": "Disk space used",
        "event_rate": "Events per second",
        "error_rate": "Errors per minute"
      },
      "learning_metrics": {
        "pattern_count": "Number of learned patterns",
        "model_accuracy": "Model accuracy (0-1)",
        "training_duration_ms": "Training time",
        "exploration_rate": "Epsilon-greedy epsilon value",
        "reward_signal": "Current reward signal"
      },
      "routing_metrics": {
        "moe_confidence": "MoE routing confidence (0-1)",
        "fallback_rate": "Routing fallback rate (0-1)",
        "distribution": "Task distribution across masters",
        "latency_ms": "Routing latency"
      }
    }
  }
}
