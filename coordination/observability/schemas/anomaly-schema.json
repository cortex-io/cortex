{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Commit-Relay Anomaly Schema",
  "description": "Schema for detected anomalies in the commit-relay system",
  "version": "1.0.0",

  "definitions": {
    "anomaly": {
      "type": "object",
      "required": [
        "anomaly_id",
        "timestamp",
        "detection_time",
        "type",
        "category",
        "severity",
        "metric_name",
        "baseline_value",
        "current_value",
        "deviation",
        "status"
      ],
      "properties": {
        "anomaly_id": {
          "type": "string",
          "pattern": "^anomaly-[0-9]+-[a-z0-9]+$",
          "description": "Unique anomaly identifier"
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp (ms) when anomaly occurred"
        },
        "detection_time": {
          "type": "integer",
          "description": "Unix timestamp (ms) when anomaly was detected"
        },
        "type": {
          "type": "string",
          "enum": [
            "success_rate_drop",
            "token_usage_spike",
            "queue_depth_explosion",
            "routing_confidence_degradation",
            "worker_failure_clustering",
            "execution_time_spike",
            "error_rate_spike",
            "resource_exhaustion",
            "throughput_degradation",
            "latency_spike"
          ],
          "description": "Type of anomaly detected"
        },
        "category": {
          "type": "string",
          "enum": [
            "performance",
            "reliability",
            "resource",
            "quality"
          ],
          "description": "Anomaly category"
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Severity level of the anomaly"
        },
        "metric_name": {
          "type": "string",
          "description": "Name of the metric that triggered the anomaly"
        },
        "baseline_value": {
          "type": "number",
          "description": "Expected baseline value"
        },
        "baseline_stddev": {
          "type": "number",
          "description": "Standard deviation of baseline"
        },
        "current_value": {
          "type": "number",
          "description": "Current observed value"
        },
        "deviation": {
          "type": "number",
          "description": "Number of standard deviations from baseline"
        },
        "deviation_percentage": {
          "type": "number",
          "description": "Percentage deviation from baseline"
        },
        "detection_method": {
          "type": "string",
          "enum": [
            "three_sigma",
            "moving_average",
            "rate_of_change",
            "pattern_matching",
            "threshold"
          ],
          "description": "Method used to detect anomaly"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "resolved",
            "acknowledged",
            "false_positive",
            "investigating"
          ],
          "description": "Current status of the anomaly"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the anomaly"
        },
        "context": {
          "type": "object",
          "description": "Additional context about the anomaly",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "worker_id": {
              "type": "string"
            },
            "master_id": {
              "type": "string"
            },
            "trace_id": {
              "type": "string"
            },
            "affected_resources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "baseline_window": {
          "type": "object",
          "description": "Baseline calculation window",
          "properties": {
            "start_time": {
              "type": "integer"
            },
            "end_time": {
              "type": "integer"
            },
            "sample_count": {
              "type": "integer"
            }
          }
        },
        "suggested_actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Suggested remediation actions"
        },
        "related_events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Event IDs related to this anomaly"
        },
        "related_anomalies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Related anomaly IDs (for clustering)"
        },
        "resolution_time": {
          "type": "integer",
          "description": "Unix timestamp (ms) when anomaly was resolved"
        },
        "resolution_notes": {
          "type": "string",
          "description": "Notes about how anomaly was resolved"
        }
      }
    },

    "baseline": {
      "type": "object",
      "required": [
        "metric_name",
        "window_start",
        "window_end",
        "sample_count",
        "mean",
        "stddev"
      ],
      "properties": {
        "metric_name": {
          "type": "string",
          "description": "Name of the metric"
        },
        "window_start": {
          "type": "integer",
          "description": "Start of baseline window (ms)"
        },
        "window_end": {
          "type": "integer",
          "description": "End of baseline window (ms)"
        },
        "sample_count": {
          "type": "integer",
          "description": "Number of samples in baseline"
        },
        "mean": {
          "type": "number",
          "description": "Mean value of metric"
        },
        "stddev": {
          "type": "number",
          "description": "Standard deviation"
        },
        "min": {
          "type": "number",
          "description": "Minimum observed value"
        },
        "max": {
          "type": "number",
          "description": "Maximum observed value"
        },
        "p50": {
          "type": "number",
          "description": "50th percentile"
        },
        "p95": {
          "type": "number",
          "description": "95th percentile"
        },
        "p99": {
          "type": "number",
          "description": "99th percentile"
        }
      }
    },

    "anomaly_summary": {
      "type": "object",
      "description": "Summary statistics for anomalies",
      "properties": {
        "timestamp": {
          "type": "integer"
        },
        "total_anomalies": {
          "type": "integer"
        },
        "active_anomalies": {
          "type": "integer"
        },
        "resolved_anomalies": {
          "type": "integer"
        },
        "false_positives": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "properties": {
            "critical": {"type": "integer"},
            "high": {"type": "integer"},
            "medium": {"type": "integer"},
            "low": {"type": "integer"}
          }
        },
        "by_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "detection_accuracy": {
          "type": "number",
          "description": "Percentage of true positives"
        },
        "false_positive_rate": {
          "type": "number",
          "description": "Percentage of false positives"
        },
        "mean_detection_time_ms": {
          "type": "number",
          "description": "Average time to detect anomalies"
        },
        "mean_resolution_time_ms": {
          "type": "number",
          "description": "Average time to resolve anomalies"
        }
      }
    }
  }
}
