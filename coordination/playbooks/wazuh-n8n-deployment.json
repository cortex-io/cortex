      "debug_commands": [
        "kubectl logs -n wazuh wazuh-indexer-0 --previous",
        "kubectl describe pod -n wazuh wazuh-indexer-0"
      ],
      "fix": "Add privileged init container to set sysctl vm.max_map_count"
    },
    "webhook_not_working": {
      "symptom": "Alerts not reaching n8n",
      "likely_causes": [
