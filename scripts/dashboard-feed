#!/usr/bin/env bash
#
# Dashboard Feed CLI
# Part of Phase 7.1: Real-time Activity Feed
#

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/dashboard/activity-feed.sh"

main() {
    local command="${1:-help}"

    case "$command" in
        stream)
            local filter="${2:-}"
            local limit="${3:-50}"
            stream_events "$filter" "$limit" | jq .
            ;;

        search)
            local keyword="${2:?Keyword required}"
            local limit="${3:-100}"
            search_events "$keyword" "$limit" | jq .
            ;;

        filter)
            local type="${2:-}"
            local severity="${3:-}"
            local source="${4:-}"
            filter_events "$type" "$severity" "$source" | jq .
            ;;

        timeline)
            local hours="${2:-24}"
            local bucket="${3:-60}"
            get_timeline "$hours" "$bucket" | jq .
            ;;

        summary)
            local hours="${2:-24}"
            get_event_summary "$hours" | jq .
            ;;

        entity)
            local entity_id="${2:?Entity ID required}"
            local limit="${3:-50}"
            get_entity_activity "$entity_id" "$limit" | jq .
            ;;

        stats)
            local hours="${2:-24}"
            get_activity_stats "$hours" | jq .
            ;;

        report)
            local hours="${2:-24}"
            local output="${3:-}"
            create_activity_report "$hours" "$output"
            ;;

        subscribe)
            local filter="${2:-}"
            subscribe_stream "$filter"
            ;;

        help|--help|-h)
            cat <<EOF
Dashboard Feed CLI - Real-time activity streaming

Usage: $0 <command> [options]

Commands:
  stream [filter] [limit]       Stream recent events
  search <keyword> [limit]      Search events by keyword
  filter [type] [severity] [source]
                                Filter events by criteria
  timeline [hours] [bucket]     Get activity timeline
  summary [hours]               Get event summary
  entity <id> [limit]           Get entity activity
  stats [hours]                 Get activity statistics
  report [hours] [output]       Generate activity report
  subscribe [filter]            Subscribe to event stream

Examples:
  $0 stream task 50
  $0 search "error" 100
  $0 filter worker warning development
  $0 timeline 24 60
  $0 summary 48
  $0 stats
  $0 report 24 activity-report.json

EOF
            ;;

        *)
            echo "Unknown command: $command"
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
