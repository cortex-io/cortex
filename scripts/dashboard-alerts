#!/usr/bin/env bash
#
# Dashboard Alerts CLI
# Part of Phase 7.4: Alerting & Notifications
#

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/dashboard/alerting.sh"

main() {
    local command="${1:-help}"

    case "$command" in
        list)
            local severity="${2:-}"
            get_active_alerts "$severity" | jq .
            ;;

        create)
            local severity="${2:?Severity required}"
            local message="${3:?Message required}"
            local source="${4:-manual}"
            local alert_id=$(create_alert "$severity" "$message" "$source")
            echo "Created alert: $alert_id"
            ;;

        ack)
            local alert_id="${2:?Alert ID required}"
            local by="${3:-manual}"
            acknowledge_alert "$alert_id" "$by"
            ;;

        resolve)
            local alert_id="${2:?Alert ID required}"
            local resolution="${3:-resolved}"
            resolve_alert "$alert_id" "$resolution"
            ;;

        check)
            check_alert_rules | jq .
            ;;

        spike)
            local threshold="${2:-20}"
            local window="${3:-30}"
            detect_error_spike "$threshold" "$window" | jq .
            ;;

        resources)
            check_resource_exhaustion | jq .
            ;;

        stats)
            local hours="${2:-24}"
            get_alert_stats "$hours" | jq .
            ;;

        configure)
            local rule_id="${2:?Rule ID required}"
            local metric="${3:?Metric required}"
            local condition="${4:?Condition required}"
            local threshold="${5:?Threshold required}"
            local severity="${6:?Severity required}"
            local message="${7:?Message required}"
            configure_rule "$rule_id" "$metric" "$condition" "$threshold" "$severity" "$message"
            ;;

        summary)
            get_alerting_summary | jq .
            ;;

        help|--help|-h)
            cat <<EOF
Dashboard Alerts CLI - Alerting and notifications

Usage: $0 <command> [options]

Commands:
  list [severity]               List active alerts
  create <severity> <message> [source]
                                Create new alert
  ack <alert-id> [by]           Acknowledge alert
  resolve <alert-id> [resolution]
                                Resolve alert
  check                         Check alert rules
  spike [threshold] [window]    Detect error spikes
  resources                     Check resource exhaustion
  stats [hours]                 Get alert statistics
  configure <rule-id> <metric> <condition> <threshold> <severity> <message>
                                Configure alert rule
  summary                       Get alerting summary

Severities: critical, warning, info

Examples:
  $0 list
  $0 list critical
  $0 create warning "High memory usage" system
  $0 ack alert-12345 operator
  $0 resolve alert-12345 "Restarted service"
  $0 check
  $0 spike 15 60
  $0 resources
  $0 stats 48
  $0 summary

EOF
            ;;

        *)
            echo "Unknown command: $command"
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
