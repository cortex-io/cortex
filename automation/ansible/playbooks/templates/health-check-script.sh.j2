#!/usr/bin/env bash
# check-{{ mcp_repo_name }}-health.sh
# Health check monitoring for {{ mcp_repo_name }}
# Auto-generated by Ansible on {{ integration_date }}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
MONITORING_CONFIG="${PROJECT_ROOT}/coordination/monitoring/{{ mcp_repo_name }}.json"
EVENTS_LOG="${PROJECT_ROOT}/coordination/dashboard-events.jsonl"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

OVERALL_STATUS="healthy"
FAILED_CHECKS=0
WARNINGS=0
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}{{ mcp_repo_name }} Health Check${NC}"
echo -e "${BLUE}========================================${NC}"
echo ""

log_event() {
    local event_type="$1"
    local severity="$2"
    local message="$3"
    local component="${4:-{{ mcp_repo_name }}}"

    local event_json=$(cat <<EOF
{"timestamp":"${TIMESTAMP}","event_type":"${event_type}","severity":"${severity}","component":"${component}","message":"${message}","source":"health_check"}
EOF
)
    echo "${event_json}" >> "${EVENTS_LOG}"
}

check_monitoring_config() {
    echo -e "${BLUE}[1/6] Checking monitoring configuration...${NC}"
    if [[ ! -f "${MONITORING_CONFIG}" ]]; then
        echo -e "${RED}✗ Monitoring configuration not found${NC}"
        log_event "health_check_failed" "high" "Monitoring configuration not found"
        ((FAILED_CHECKS++))
        OVERALL_STATUS="unhealthy"
        return 1
    fi
    echo -e "${GREEN}✓ Monitoring configuration found${NC}"
    return 0
}

check_repository() {
    echo -e "${BLUE}[2/6] Checking repository...${NC}"
    local repo_path="{{ mcp_local_path }}"

    if [[ ! -d "${repo_path}" ]]; then
        echo -e "${YELLOW}⚠ Repository not found locally${NC}"
        log_event "repository_check" "low" "Repository not cloned locally"
        ((WARNINGS++))
        return 0
    fi

    echo -e "${GREEN}✓ Repository found${NC}"

    if [[ -d "${repo_path}/.git" ]]; then
        cd "${repo_path}"
        git fetch origin --quiet 2>/dev/null || true
        local behind_commits=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo "0")

        if [[ "${behind_commits}" -gt 0 ]]; then
            echo -e "${YELLOW}⚠ Repository is ${behind_commits} commits behind${NC}"
            log_event "repository_outdated" "low" "Repository is ${behind_commits} commits behind"
            ((WARNINGS++))
        else
            echo -e "${GREEN}✓ Repository is up to date${NC}"
        fi
        cd "${PROJECT_ROOT}"
    fi
    return 0
}
{% if agent_card_check.stat.exists %}

check_a2a_protocol() {
    echo -e "${BLUE}[3/6] Validating A2A protocol compliance...${NC}"
    local repo_path="{{ mcp_local_path }}"
    local agent_card="${repo_path}/agent-card.json"

    if [[ ! -f "${agent_card}" ]]; then
        echo -e "${YELLOW}⚠ Agent card not found${NC}"
        ((WARNINGS++))
        return 0
    fi

    if ! jq empty "${agent_card}" 2>/dev/null; then
        echo -e "${RED}✗ Invalid agent-card.json syntax${NC}"
        log_event "a2a_protocol_invalid" "high" "agent-card.json has invalid JSON"
        ((FAILED_CHECKS++))
        OVERALL_STATUS="degraded"
        return 1
    fi

    local skills_count=$(jq '.skills | length' "${agent_card}" 2>/dev/null || echo "0")
    echo -e "${GREEN}✓ Agent card valid (${skills_count} skills)${NC}"
    return 0
}
{% else %}

check_a2a_protocol() {
    echo -e "${BLUE}[3/6] Validating A2A protocol compliance...${NC}"
    echo -e "${YELLOW}⚠ No agent-card.json (A2A protocol not implemented)${NC}"
    return 0
}
{% endif %}
{% if mcp_language == "Python" %}

check_python_environment() {
    echo -e "${BLUE}[4/6] Checking Python environment...${NC}"

    if ! command -v python3 &> /dev/null; then
        echo -e "${YELLOW}⚠ Python 3 not found${NC}"
        ((WARNINGS++))
        return 0
    fi

    local python_version=$(python3 --version 2>&1 | awk '{print $2}')
    echo -e "${GREEN}✓ Python ${python_version} found${NC}"

    if command -v {{ mcp_package_manager }} &> /dev/null; then
        echo -e "${GREEN}✓ {{ mcp_package_manager }} package manager installed${NC}"
    else
        echo -e "${YELLOW}⚠ {{ mcp_package_manager }} package manager not found${NC}"
        ((WARNINGS++))
    fi

    return 0
}
{% elif mcp_language == "TypeScript" %}

check_node_environment() {
    echo -e "${BLUE}[4/6] Checking Node.js environment...${NC}"

    if ! command -v node &> /dev/null; then
        echo -e "${YELLOW}⚠ Node.js not found${NC}"
        ((WARNINGS++))
        return 0
    fi

    local node_version=$(node --version)
    echo -e "${GREEN}✓ Node.js ${node_version} found${NC}"

    if command -v npm &> /dev/null; then
        echo -e "${GREEN}✓ npm package manager installed${NC}"
    else
        echo -e "${YELLOW}⚠ npm not found${NC}"
        ((WARNINGS++))
    fi

    return 0
}
{% else %}

check_runtime_environment() {
    echo -e "${BLUE}[4/6] Checking runtime environment...${NC}"
    echo -e "${GREEN}✓ Environment check skipped (language-specific)${NC}"
    return 0
}
{% endif %}
{% if api_keys_required == "yes" %}

check_security_posture() {
    echo -e "${BLUE}[5/6] Checking security posture...${NC}"
    local repo_path="{{ mcp_local_path }}"

    if [[ ! -d "${repo_path}" ]]; then
        echo -e "${YELLOW}⚠ Repository not found (skipping)${NC}"
        return 0
    fi

    # Check if secrets.env is in .gitignore
    if [[ -f "${repo_path}/.gitignore" ]]; then
        if grep -q "secrets.env" "${repo_path}/.gitignore"; then
            echo -e "${GREEN}✓ secrets.env properly excluded from git${NC}"
        else
            echo -e "${RED}✗ secrets.env not in .gitignore (SECURITY RISK)${NC}"
            log_event "security_risk" "critical" "secrets.env not excluded from git"
            ((FAILED_CHECKS++))
            OVERALL_STATUS="unhealthy"
        fi
    fi

    return 0
}
{% else %}

check_security_posture() {
    echo -e "${BLUE}[5/6] Checking security posture...${NC}"
    echo -e "${GREEN}✓ No API keys required${NC}"
    return 0
}
{% endif %}

check_cortex_integration() {
    echo -e "${BLUE}[6/6] Checking Cortex integration...${NC}"

    if grep -q "{{ mcp_repo_name }}" "${PROJECT_ROOT}/coordination/repository-inventory.json" 2>/dev/null; then
        echo -e "${GREEN}✓ Repository in inventory${NC}"
    else
        echo -e "${YELLOW}⚠ Repository not in inventory${NC}"
        ((WARNINGS++))
    fi

    if [[ -f "${MONITORING_CONFIG}" ]]; then
        local monitoring_enabled=$(jq -r '.monitoring_config.enabled' "${MONITORING_CONFIG}" 2>/dev/null || echo "false")
        if [[ "${monitoring_enabled}" == "true" ]]; then
            echo -e "${GREEN}✓ Monitoring enabled${NC}"
        else
            echo -e "${YELLOW}⚠ Monitoring disabled${NC}"
            ((WARNINGS++))
        fi
    fi

    return 0
}

generate_health_summary() {
    echo ""
    echo -e "${BLUE}========================================${NC}"
    echo -e "${BLUE}Health Check Summary${NC}"
    echo -e "${BLUE}========================================${NC}"

    if [[ "${OVERALL_STATUS}" == "healthy" ]]; then
        echo -e "${GREEN}Overall Status: HEALTHY${NC}"
        log_event "health_check_passed" "info" "{{ mcp_repo_name }} health check passed"
    elif [[ "${OVERALL_STATUS}" == "degraded" ]]; then
        echo -e "${YELLOW}Overall Status: DEGRADED${NC}"
        log_event "health_check_degraded" "medium" "{{ mcp_repo_name }} health check degraded"
    else
        echo -e "${RED}Overall Status: UNHEALTHY${NC}"
        log_event "health_check_failed" "high" "{{ mcp_repo_name }} health check failed"
    fi

    echo -e "Failed Checks: ${FAILED_CHECKS}"
    echo -e "Warnings: ${WARNINGS}"
    echo ""

    local summary_file="${PROJECT_ROOT}/coordination/monitoring/{{ mcp_repo_name }}-health-summary.json"
    cat > "${summary_file}" <<EOF
{
  "timestamp": "${TIMESTAMP}",
  "overall_status": "${OVERALL_STATUS}",
  "failed_checks": ${FAILED_CHECKS},
  "warnings": ${WARNINGS}
}
EOF
}

main() {
    check_monitoring_config || true
    check_repository || true
    check_a2a_protocol || true
{% if mcp_language == "Python" %}
    check_python_environment || true
{% elif mcp_language == "TypeScript" %}
    check_node_environment || true
{% else %}
    check_runtime_environment || true
{% endif %}
    check_security_posture || true
    check_cortex_integration || true
    generate_health_summary

    if [[ "${OVERALL_STATUS}" == "unhealthy" ]]; then
        exit 2
    elif [[ "${OVERALL_STATUS}" == "degraded" ]]; then
        exit 1
    else
        exit 0
    fi
}

main "$@"
