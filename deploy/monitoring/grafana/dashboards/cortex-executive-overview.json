    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Overall system health score based on availability, performance, and error rates",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(\n  (avg(up{namespace=\"$namespace\"}) * 40) +\n  (avg(1 - rate(cortex_task_failures_total{namespace=\"$namespace\"}[5m]) / (rate(cortex_task_completions_total{namespace=\"$namespace\"}[5m]) + rate(cortex_task_failures_total{namespace=\"$namespace\"}[5m]) + 0.001)) * 30) +\n  (avg(1 - rate(cortex_token_limit_exceeded_total{namespace=\"$namespace\"}[5m]) / (rate(cortex_token_requests_total{namespace=\"$namespace\"}[5m]) + 0.001)) * 20) +\n  (clamp_max(100 - avg(cortex_alert_firing{namespace=\"$namespace\",severity=\"critical\"}) * 50 - avg(cortex_alert_firing{namespace=\"$namespace\",severity=\"warning\"}) * 10, 100) * 0.1)\n) * 100 / 90",
          "legendFormat": "Health Score",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "System Health Score",
      "type": "gauge"
    },
