      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_REPORTS }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=Daily Health Report - {{ $json.overallHealth }}"
            },
            {
              "name": "blocks",
              "value": "=[{\"type\":\"header\",\"text\":{\"type\":\"plain_text\",\"text\":\"📊 Daily Health Report - {{ $json.reportDate }}\"}},{\"type\":\"section\",\"fields\":[{\"type\":\"mrkdwn\",\"text\":\"*Overall Health:*\\n{{ $json.overallHealth }}\"},{\"type\":\"mrkdwn\",\"text\":\"*SLO Score:*\\n{{ $json.sloScore }}%\"},{\"type\":\"mrkdwn\",\"text\":\"*Request Rate:*\\n{{ $json.metrics.requestRate }} req/s\"},{\"type\":\"mrkdwn\",\"text\":\"*Error Rate:*\\n{{ $json.metrics.errorRate }}%\"},{\"type\":\"mrkdwn\",\"text\":\"*Uptime:*\\n{{ $json.metrics.uptime }}%\"},{\"type\":\"mrkdwn\",\"text\":\"*Tasks Completed:*\\n{{ $json.metrics.tasksCompleted }}\"}]},{\"type\":\"section\",\"text\":{\"type\":\"mrkdwn\",\"text\":\"*Trend:* {{ $json.trends.trend }} ({{ $json.trends.percentChange }}% change)\"}},{\"type\":\"divider\"},{\"type\":\"context\",\"elements\":[{\"type\":\"mrkdwn\",\"text\":\"Full report sent via email | Generated at {{ $now.toISO() }}\"}]}]"
            }
          ]
        },
        "options": {}
      },
      "id": "send-slack-summary",
      "name": "Send Slack Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1850, 550]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUDIT_LOG_API }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "type",
              "value": "daily_health_report"
            },
            {
              "name": "report",
              "value": "={{ { reportDate: $json.reportDate, sloScore: $json.sloScore, overallHealth: $json.overallHealth, metrics: $json.metrics } }}"
            },
            {
              "name": "timestamp",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "log-report-audit",
      "name": "Log Report to Audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2050, 450]
    }
  ],
