        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=Weekly Governance Report - Compliance Rate: {{ $json.weeklyReport.statistics.complianceRate }}%"
            },
            {
              "name": "blocks",
              "value": "=[{\"type\":\"header\",\"text\":{\"type\":\"plain_text\",\"text\":\"📋 Weekly Governance Compliance Report\"}},{\"type\":\"section\",\"fields\":[{\"type\":\"mrkdwn\",\"text\":\"*Period:*\\n{{ $json.weeklyReport.period }}\"},{\"type\":\"mrkdwn\",\"text\":\"*Compliance Rate:*\\n{{ $json.weeklyReport.statistics.complianceRate }}%\"},{\"type\":\"mrkdwn\",\"text\":\"*Total Events:*\\n{{ $json.weeklyReport.statistics.totalEvents }}\"},{\"type\":\"mrkdwn\",\"text\":\"*Violations:*\\n{{ $json.weeklyReport.statistics.violationEvents }}\"}]},{\"type\":\"section\",\"text\":{\"type\":\"mrkdwn\",\"text\":\"*Top Policy Violations:*\\n{{ $json.weeklyReport.topViolations.map(v => `• ${v.policy}: ${v.count} occurrences`).join('\\\\n') || 'None' }}\"}},{\"type\":\"section\",\"text\":{\"type\":\"mrkdwn\",\"text\":\"*Trend:* {{ $json.weeklyReport.trend.toUpperCase() }}\"}}]"
            }
          ]
        },
        "options": {}
      },
      "id": "send-weekly-report",
      "name": "Send Weekly Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 600]
    }
