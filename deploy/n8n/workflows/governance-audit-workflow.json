    {
      "parameters": {
        "jsCode": "// Generate compliance report summary\nconst event = $input.item.json;\n\nconst summary = {\n  eventId: `${Date.now()}-${event.user}`,\n  eventType: event.eventType,\n  complianceStatus: event.validationResults.complianceStatus,\n  summary: {\n    total_checks: event.validationResults.passedCount + event.validationResults.warningCount + event.validationResults.violationCount,\n    passed: event.validationResults.passedCount,\n    warnings: event.validationResults.warningCount,\n    violations: event.validationResults.violationCount\n  },\n  actionRequired: event.validationResults.violationCount > 0,\n  actionDetails: event.validationResults.violations.length > 0 \n    ? `Review ${event.validationResults.violations.length} policy violation(s)` \n    : 'No action required',\n  timestamp: event.timestamp,\n  processedAt: new Date().toISOString()\n};\n\nreturn [{ json: summary }];"
      },
      "id": "generate-summary",
      "name": "Generate Compliance Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2450, 300]
