        "options": {}
      },
      "id": "get-weekly-audit-data",
      "name": "Get Weekly Audit Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 600]
    },
    {
      "parameters": {
        "jsCode": "// Analyze weekly compliance data\nconst auditData = $input.item.json;\n\nconst stats = {\n  totalEvents: auditData.events?.length || 0,\n  compliantEvents: auditData.events?.filter(e => e.complianceStatus === 'compliant').length || 0,\n  violationEvents: auditData.events?.filter(e => e.complianceStatus === 'non_compliant').length || 0,\n  warningEvents: auditData.events?.filter(e => e.complianceStatus === 'compliant_with_warnings').length || 0\n};\n\nstats.complianceRate = stats.totalEvents > 0 ? ((stats.compliantEvents / stats.totalEvents) * 100).toFixed(2) : 100;\n\nconst topViolations = {};\nauditData.events?.forEach(event => {\n  event.violations?.forEach(violation => {\n    const key = violation.policyName;\n    topViolations[key] = (topViolations[key] || 0) + 1;\n  });\n});\n\nconst sortedViolations = Object.entries(topViolations)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 5)\n  .map(([policy, count]) => ({ policy, count }));\n\nreturn [{\n  json: {\n    weeklyReport: {\n      period: 'Last 7 days',\n      generatedAt: new Date().toISOString(),\n      statistics: stats,\n      topViolations: sortedViolations,\n      trend: stats.complianceRate >= 95 ? 'excellent' : stats.complianceRate >= 85 ? 'good' : stats.complianceRate >= 70 ? 'needs_improvement' : 'critical'\n    }\n  }\n}];"
      },
      "id": "analyze-weekly-compliance",
      "name": "Analyze Weekly Compliance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_GOVERNANCE }}",
