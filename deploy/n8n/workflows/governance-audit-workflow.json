      "parameters": {
        "method": "GET",
        "url": "={{ $env.GOVERNANCE_API }}/audit/weekly",
        "authentication": "genericCredentialType",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "7"
            }
          ]
