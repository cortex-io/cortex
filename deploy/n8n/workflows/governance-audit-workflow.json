    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.GOVERNANCE_API }}/policies",
        "authentication": "genericCredentialType",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "category",
              "value": "={{ $json.eventCategory }}"
            },
            {
              "name": "active",
              "value": "true"
