      "id": "load-governance-policies",
      "name": "Load Governance Policies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "jsCode": "// Validate event against governance policies\nconst event = $input.first().json;\nconst policies = $input.last().json.policies || [];\n\nconst violations = [];\nconst warnings = [];\nconst passed = [];\n\npolicies.forEach(policy => {\n  const policyId = policy.id;\n  const policyName = policy.name;\n  const rules = policy.rules || [];\n  \n  rules.forEach(rule => {\n    let result = { policyId, policyName, rule: rule.name, status: 'pass' };\n    \n    try {\n      // Example policy validations\n      switch (rule.type) {\n        case 'require_approval':\n          if (!event.metadata?.approvedBy) {\n            result.status = 'violation';\n            result.message = 'Change requires approval but none found';\n          }\n          break;\n          \n        case 'allowed_users':\n          if (!rule.allowedUsers?.includes(event.user)) {\n            result.status = 'violation';\n            result.message = `User ${event.user} not authorized for this change`;\n          }\n          break;\n          \n        case 'change_window':\n          const currentHour = new Date().getHours();\n          if (currentHour < rule.startHour || currentHour > rule.endHour) {\n            result.status = 'warning';\n            result.message = `Change outside approved window (${rule.startHour}:00-${rule.endHour}:00)`;\n          }\n          break;\n          \n        case 'require_documentation':\n          if (!event.metadata?.documentation) {\n            result.status = 'warning';\n            result.message = 'Change lacks documentation';\n          }\n          break;\n          \n        case 'prohibited_resources':\n          const resourceType = event.resource?.type;\n          if (rule.prohibited?.includes(resourceType)) {\n            result.status = 'violation';\n            result.message = `Resource type ${resourceType} is prohibited`;\n          }\n          break;\n          \n        case 'require_testing':\n          if (!event.metadata?.testResults) {\n            result.status = 'warning';\n            result.message = 'No test results provided';\n          }\n          break;\n      }\n    } catch (error) {\n      result.status = 'error';\n      result.message = `Policy validation error: ${error.message}`;\n    }\n    \n    if (result.status === 'violation') {\n      violations.push(result);\n    } else if (result.status === 'warning') {\n      warnings.push(result);\n    } else {\n      passed.push(result);\n    }\n  });\n});\n\nconst complianceStatus = violations.length > 0 ? 'non_compliant' : warnings.length > 0 ? 'compliant_with_warnings' : 'compliant';\n\nreturn [{\n  json: {\n    ...event,\n    validationResults: {\n      complianceStatus: complianceStatus,\n      violationCount: violations.length,\n      warningCount: warnings.length,\n      passedCount: passed.length,\n      violations: violations,\n      warnings: warnings,\n      passed: passed\n    },\n    requiresIntervention: violations.length > 0\n  }\n}];"
      },
      "id": "validate-policies",
      "name": "Validate Against Policies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300]
    },
