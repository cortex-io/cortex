# N8N Workflow Configuration Template
# Copy this file to .env and configure with your actual values

# =============================================================================
# ALERTMANAGER CONFIGURATION
# =============================================================================
ALERTMANAGER_URL=http://alertmanager.cortex.svc.cluster.local:9093

# =============================================================================
# PROMETHEUS CONFIGURATION
# =============================================================================
PROMETHEUS_URL=http://prometheus.cortex.svc.cluster.local:9090

# =============================================================================
# SLACK WEBHOOK CONFIGURATION
# =============================================================================
# Critical alerts webhook (for severity=critical)
SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Team channel webhook (for severity=warning)
SLACK_WEBHOOK_TEAM=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Escalation channel webhook
SLACK_WEBHOOK_ESCALATION=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Auto-remediation notifications
SLACK_WEBHOOK_REMEDIATION=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Daily health reports
SLACK_WEBHOOK_REPORTS=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Governance violations
SLACK_WEBHOOK_GOVERNANCE=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# From address for alert emails
ALERT_FROM_EMAIL=alerts@cortex.example.com

# On-call email for critical alerts
ONCALL_EMAIL=oncall@cortex.example.com

# From address for reports
REPORT_FROM_EMAIL=reports@cortex.example.com

# Recipients for daily health reports
REPORT_TO_EMAIL=team@cortex.example.com

# =============================================================================
# API ENDPOINTS
# =============================================================================
# Audit logging service
AUDIT_LOG_API=http://audit-service.cortex.svc.cluster.local:8080/api/v1/logs

# Escalation database/tracking service
ESCALATION_DB_API=http://escalation-db.cortex.svc.cluster.local:8080/api/v1

# On-call rotation service
ONCALL_API=http://oncall-service.cortex.svc.cluster.local:8080/api/v1

# Governance policy service
GOVERNANCE_API=http://governance-service.cortex.svc.cluster.local:8080/api/v1

# =============================================================================
# PAGERDUTY CONFIGURATION
# =============================================================================
# PagerDuty Events API v2 integration key
# Create at: PagerDuty > Services > Your Service > Integrations > Events API V2
PAGERDUTY_ROUTING_KEY=R012345678901234567890ABCDEF

# PagerDuty API endpoint (usually doesn't need to change)
PAGERDUTY_API_URL=https://events.pagerduty.com/v2/enqueue

# =============================================================================
# OPSGENIE CONFIGURATION (Alternative to PagerDuty)
# =============================================================================
# OPSGENIE_API_KEY=your-opsgenie-api-key
# OPSGENIE_API_URL=https://api.opsgenie.com/v2/alerts

# =============================================================================
# WAZUH SIEM CONFIGURATION
# =============================================================================
# Wazuh manager endpoint
WAZUH_API=http://wazuh-manager.security.svc.cluster.local:55000

# Wazuh API token
# Generate at: Wazuh UI > Settings > API > Create Token
WAZUH_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# KUBERNETES CONFIGURATION
# =============================================================================
# If N8N is running outside Kubernetes cluster, specify kubeconfig path
# KUBECONFIG=/path/to/kubeconfig

# Default namespace for Cortex deployments
CORTEX_NAMESPACE=cortex

# =============================================================================
# SLO TARGET CONFIGURATION
# =============================================================================
# Uptime target (percentage)
SLO_UPTIME_TARGET=99.9

# Error rate target (percentage)
SLO_ERROR_RATE_TARGET=1.0

# Latency P95 target (seconds)
SLO_LATENCY_P95_TARGET=1.0

# =============================================================================
# ESCALATION CONFIGURATION
# =============================================================================
# Time window for alert acknowledgment before escalation (minutes)
ESCALATION_ACK_WINDOW=15

# Maximum escalation level
ESCALATION_MAX_LEVEL=5

# =============================================================================
# AUTO-REMEDIATION CONFIGURATION
# =============================================================================
# Enable/disable auto-remediation features
AUTO_REMEDIATION_ENABLED=true

# Require manual approval for destructive actions
AUTO_REMEDIATION_REQUIRE_APPROVAL=false

# Maximum pod restarts per hour (rate limiting)
AUTO_REMEDIATION_MAX_RESTARTS_PER_HOUR=10

# =============================================================================
# REPORT CONFIGURATION
# =============================================================================
# Daily report schedule (cron format)
DAILY_REPORT_SCHEDULE=0 8 * * *

# Weekly compliance report schedule (cron format)
WEEKLY_COMPLIANCE_SCHEDULE=0 0 * * 0

# Report time zone
REPORT_TIMEZONE=America/New_York

# =============================================================================
# GOVERNANCE CONFIGURATION
# =============================================================================
# Governance policy enforcement level (strict, moderate, permissive)
GOVERNANCE_ENFORCEMENT_LEVEL=strict

# Automatically block non-compliant changes
GOVERNANCE_AUTO_BLOCK=false

# Governance audit retention days
GOVERNANCE_AUDIT_RETENTION_DAYS=90

# =============================================================================
# NOTIFICATION PREFERENCES
# =============================================================================
# Notification channels for different severity levels
# Comma-separated: slack,email,pagerduty,sms
NOTIFICATION_CRITICAL=slack,email,pagerduty
NOTIFICATION_WARNING=slack,email
NOTIFICATION_INFO=slack

# Quiet hours for non-critical notifications (24h format)
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# =============================================================================
# DEDUPLICATION CONFIGURATION
# =============================================================================
# Deduplication time window (minutes)
DEDUP_WINDOW_MINUTES=5

# Maximum alerts per group before suppression
DEDUP_MAX_ALERTS_PER_GROUP=50

# =============================================================================
# INTEGRATION ENDPOINTS (Optional)
# =============================================================================
# Discord webhook (alternative to Slack)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Microsoft Teams webhook
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Custom webhook endpoint
# CUSTOM_WEBHOOK_URL=https://your-service.com/webhook

# =============================================================================
# LOGGING & DEBUGGING
# =============================================================================
# N8N workflow execution logging level (error, warn, info, debug)
N8N_LOG_LEVEL=info

# Enable detailed execution logs
N8N_DETAILED_LOGGING=false

# Maximum execution retention (days)
N8N_EXECUTION_RETENTION_DAYS=30

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Maximum concurrent workflow executions
N8N_MAX_CONCURRENT_EXECUTIONS=10

# Timeout for external API calls (seconds)
API_CALL_TIMEOUT=30

# Prometheus query timeout (seconds)
PROMETHEUS_QUERY_TIMEOUT=60

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Enable webhook signature verification
WEBHOOK_SIGNATURE_VERIFICATION=true

# Webhook secret for signature verification
WEBHOOK_SECRET=your-webhook-secret-key

# Enable TLS for external API calls
API_TLS_ENABLED=true

# Trust self-signed certificates (for internal services)
API_TLS_REJECT_UNAUTHORIZED=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable experimental features
FEATURE_AUTO_REMEDIATION=true
FEATURE_ESCALATION=true
FEATURE_GOVERNANCE=true
FEATURE_DAILY_REPORTS=true

# =============================================================================
# CUSTOM LABELS & TAGS
# =============================================================================
# Environment label (production, staging, development)
ENVIRONMENT=production

# Cluster identifier
CLUSTER_NAME=cortex-primary

# Region/datacenter
REGION=us-east-1

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# Custom Prometheus queries
# CUSTOM_METRIC_QUERY_1=sum(rate(custom_metric[5m]))
# CUSTOM_METRIC_QUERY_2=avg(custom_gauge_metric)

# Webhook retry configuration
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=1000

# Alert aggregation window (seconds)
ALERT_AGGREGATION_WINDOW=30
