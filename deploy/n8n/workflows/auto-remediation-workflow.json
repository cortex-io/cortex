        "jsCode": "// Parse alert payload\nconst alert = $input.item.json.body.alert || $input.item.json.body;\n\nreturn [{\n  json: {\n    alertname: alert.labels?.alertname || alert.alertname,\n    severity: alert.labels?.severity || alert.severity,\n    service: alert.labels?.service || alert.labels?.job,\n    namespace: alert.labels?.namespace || 'default',\n    pod: alert.labels?.pod || alert.labels?.pod_name,\n    instance: alert.labels?.instance,\n    container: alert.labels?.container,\n    summary: alert.annotations?.summary || '',\n    description: alert.annotations?.description || '',\n    fingerprint: alert.fingerprint || '',\n    rawAlert: alert\n  }\n}];"
      },
