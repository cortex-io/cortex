        "jsCode": "// Determine remediation success\nconst item = $input.item.json;\n\nconst success = !item.stderr && item.exitCode === 0;\nconst action = item.command || 'unknown';\n\nreturn [{\n  json: {\n    ...item,\n    remediationSuccess: success,\n    remediationAction: action,\n    remediationTimestamp: new Date().toISOString(),\n    remediationOutput: item.stdout || item.stderr || 'No output'\n  }\n}];"
