      "id": "get-worker-pods",
      "name": "Get Worker Pods",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "jsCode": "// Identify stuck worker pod\nconst alert = $input.first().json;\nconst podsInfo = JSON.parse($input.last().json.stdout || '{}');\nconst pods = podsInfo.items || [];\n\n// Find pod that matches alert instance or is in bad state\nconst stuckPod = pods.find(pod => {\n  const podName = pod.metadata?.name;\n  const status = pod.status?.phase;\n  \n  // Check if pod name matches or if pod is in problematic state\n  return podName?.includes(alert.instance) || status === 'Unknown' || status === 'Pending';\n});\n\nif (stuckPod) {\n  return [{\n    json: {\n      ...alert,\n      stuckPodName: stuckPod.metadata?.name,\n      stuckPodStatus: stuckPod.status?.phase,\n      canTerminate: true\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...alert,\n    canTerminate: false,\n    reason: 'No stuck pod found'\n  }\n}];"
      },
      "id": "identify-stuck-worker",
      "name": "Identify Stuck Worker",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 400]
    },
