    {
      "parameters": {
        "command": "kubectl logs -n {{ $json.namespace }} {{ $json.pod }} --tail=100 --previous",
        "options": {}
      },
      "id": "collect-crash-logs",
      "name": "Collect Crash Logs",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1050, 100]
    },
    {
      "parameters": {
        "jsCode": "// Analyze crash logs for common issues\nconst alert = $input.first().json;\nconst logs = $input.last().json.stdout || '';\n\nconst patterns = [\n  { pattern: /OOMKilled|Out of memory/i, issue: 'out_of_memory', action: 'increase_memory_limit' },\n  { pattern: /CrashLoopBackOff/i, issue: 'crash_loop', action: 'check_config' },\n  { pattern: /Error: ECONNREFUSED/i, issue: 'connection_refused', action: 'check_dependencies' },\n  { pattern: /permission denied/i, issue: 'permission_error', action: 'check_rbac' },\n  { pattern: /Failed to pull image/i, issue: 'image_pull_error', action: 'check_registry' }\n];\n\nlet detectedIssue = 'unknown';\nlet recommendedAction = 'restart_pod';\n\nfor (const p of patterns) {\n  if (p.pattern.test(logs)) {\n    detectedIssue = p.issue;\n    recommendedAction = p.action;\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    ...alert,\n    logs: logs.substring(0, 2000), // Truncate logs\n    detectedIssue: detectedIssue,\n    recommendedAction: recommendedAction,\n    canAutoRemediate: recommendedAction === 'restart_pod'\n  }\n}];"
      },
      "id": "analyze-crash-logs",
      "name": "Analyze Crash Logs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.canAutoRemediate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-auto-remediate-crash",
