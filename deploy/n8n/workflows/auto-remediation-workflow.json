      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1050, 250]
    },
    {
      "parameters": {
        "jsCode": "// Check if HPA exists and can scale\nconst alert = $input.first().json;\nconst podInfo = JSON.parse($input.last().json.stdout || '{}');\n\nconst memoryUsage = podInfo.status?.containerStatuses?.[0]?.resources?.requests?.memory || 'unknown';\nconst hasHPA = false; // Placeholder - check actual HPA\n\nreturn [{\n  json: {\n    ...alert,\n    currentMemoryUsage: memoryUsage,\n    hasHPA: hasHPA,\n    canScale: hasHPA,\n    recommendedAction: hasHPA ? 'trigger_hpa' : 'increase_replicas'\n  }\n}];"
      },
      "id": "check-hpa-available",
      "name": "Check HPA Available",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 250]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.hasHPA }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-hpa-exists",
      "name": "HPA Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1450, 250]
    },
