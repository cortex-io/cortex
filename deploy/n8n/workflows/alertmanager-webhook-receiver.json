{
  "name": "Alertmanager Webhook Receiver",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alertmanager",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "alertmanager-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Parse Alertmanager webhook payload\n// Alertmanager sends an array of alerts in the 'alerts' field\n\nconst payload = $input.item.json.body;\nconst alerts = payload.alerts || [];\n\nconst parsedAlerts = alerts.map(alert => {\n  return {\n    // Alert identification\n    alertName: alert.labels.alertname || 'Unknown',\n    fingerprint: alert.fingerprint || '',\n    \n    // State and timing\n    status: alert.status || 'unknown',\n    startsAt: alert.startsAt || '',\n    endsAt: alert.endsAt || '',\n    \n    // Severity and classification\n    severity: alert.labels.severity || 'info',\n    cluster: alert.labels.cluster || 'unknown',\n    namespace: alert.labels.namespace || '',\n    pod: alert.labels.pod || '',\n    container: alert.labels.container || '',\n    instance: alert.labels.instance || '',\n    \n    // All labels and annotations\n    labels: alert.labels || {},\n    annotations: alert.annotations || {},\n    \n    // Human-readable information\n    summary: alert.annotations.summary || alert.annotations.message || 'No summary',\n    description: alert.annotations.description || '',\n    \n    // URL for more details\n    generatorURL: alert.generatorURL || '',\n    \n    // Metadata\n    receivedAt: new Date().toISOString(),\n    externalURL: payload.externalURL || '',\n    groupKey: payload.groupKey || ''\n  };\n});\n\n// Return all parsed alerts\nreturn parsedAlerts.map(alert => ({ json: alert }));"
      },
      "id": "parse-payload",
      "name": "Parse Alertmanager Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "critical",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "critical"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "warning",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "warning"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "info",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "info"
            }
          ]
        },
        "options": {}
      },
      "id": "route-by-severity",
      "name": "Route by Severity",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
