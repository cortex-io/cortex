      "id": "log-info",
      "name": "Log Info Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 400]
    },
    {
      "parameters": {
        "jsCode": "// Check if alert is firing or resolved\nconst alert = $input.item.json;\nconst isFiring = alert.status === 'firing';\nconst isResolved = alert.status === 'resolved';\n\n// Add state information\nreturn {\n  json: {\n    ...alert,\n    isFiring,\n    isResolved,\n    stateChange: isFiring ? 'Alert triggered' : 'Alert resolved',\n    processedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "check-state",
      "name": "Check Alert State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"success\", \"message\": \"Alert received and processed\", \"alertsProcessed\": $itemIndex + 1 } }}"
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
