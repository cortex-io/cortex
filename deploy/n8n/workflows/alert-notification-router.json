{
  "name": "Alert Notification Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alert-notification-router",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-input",
      "name": "Webhook Input",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "alert-notification-router"
    },
    {
      "parameters": {
        "jsCode": "// Extract alert from webhook payload\nconst body = $input.item.json.body;\nconst alert = body.alert || $input.item.json;\nconst priority = body.priority || 'standard';\n\nreturn {\n  json: {\n    ...alert,\n    priority,\n    routedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "extract-alert",
      "name": "Extract Alert Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "critical",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "critical"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "warning",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "warning"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "info",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "info"
            }
          ]
        },
        "options": {}
      },
      "id": "switch-severity",
      "name": "Switch by Severity",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format message for critical alerts\nconst alert = $input.item.json;\n\nconst slackMessage = {\n  blocks: [\n    {\n      type: \"header\",\n      text: {\n        type: \"plain_text\",\n        text: `🚨 CRITICAL: ${alert.alertName}`,\n        emoji: true\n      }\n    },\n    {\n      type: \"section\",\n      fields: [\n        {\n          type: \"mrkdwn\",\n          text: `*Status:*\\n${alert.status}`\n        },\n        {\n          type: \"mrkdwn\",\n          text: `*Severity:*\\nCritical`\n        },\n        {\n          type: \"mrkdwn\",\n          text: `*Cluster:*\\n${alert.cluster}`\n        },\n        {\n          type: \"mrkdwn\",\n          text: `*Namespace:*\\n${alert.namespace || 'N/A'}`\n        }\n      ]\n    },\n    {\n      type: \"section\",\n      text: {\n        type: \"mrkdwn\",\n        text: `*Summary:*\\n${alert.summary}`\n      }\n    },\n    {\n      type: \"section\",\n      text: {\n        type: \"mrkdwn\",\n        text: `*Description:*\\n${alert.description || 'No additional details'}`\n      }\n    },\n    {\n      type: \"context\",\n      elements: [\n        {\n          type: \"mrkdwn\",\n          text: `Fired at: ${alert.startsAt} | <${alert.generatorURL}|View in Prometheus>`\n        }\n      ]\n    },\n    {\n      type: \"actions\",\n      elements: [\n        {\n          type: \"button\",\n          text: {\n            type: \"plain_text\",\n            text: \"Acknowledge\",\n            emoji: true\n          },\n          style: \"primary\",\n          value: `ack_${alert.fingerprint}`\n        },\n        {\n          type: \"button\",\n          text: {\n            type: \"plain_text\",\n            text: \"View Details\",\n            emoji: true\n          },\n          url: alert.generatorURL\n        }\n      ]\n    }\n  ]\n};\n\nconst emailContent = `\nCRITICAL ALERT: ${alert.alertName}\n\nStatus: ${alert.status}\nSeverity: Critical\nCluster: ${alert.cluster}\nNamespace: ${alert.namespace || 'N/A'}\nPod: ${alert.pod || 'N/A'}\n\nSummary:\n${alert.summary}\n\nDescription:\n${alert.description || 'No additional details'}\n\nFired at: ${alert.startsAt}\nGenerator URL: ${alert.generatorURL}\n\nThis is an automated alert from Cortex Monitoring System.\n`;\n\nreturn {\n  json: {\n    alert,\n    slackMessage,\n    emailSubject: `[CRITICAL] ${alert.alertName} - ${alert.cluster}`,\n    emailContent\n  }\n};"
      },
      "id": "format-critical",
      "name": "Format Critical Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 150]
    },
    {
      "parameters": {
        "jsCode": "// Format message for warning alerts\nconst alert = $input.item.json;\n\nconst slackMessage = {\n  blocks: [\n    {\n      type: \"header\",\n      text: {\n        type: \"plain_text\",\n        text: `⚠️ WARNING: ${alert.alertName}`,\n        emoji: true\n      }\n    },\n    {\n      type: \"section\",\n      fields: [\n        {\n          type: \"mrkdwn\",\n          text: `*Status:*\\n${alert.status}`\n        },\n        {\n          type: \"mrkdwn\",\n          text: `*Severity:*\\nWarning`\n        },\n        {\n          type: \"mrkdwn\",\n          text: `*Cluster:*\\n${alert.cluster}`\n        },\n        {\n          type: \"mrkdwn\",\n          text: `*Instance:*\\n${alert.instance || 'N/A'}`\n        }\n      ]\n    },\n    {\n      type: \"section\",\n      text: {\n        type: \"mrkdwn\",\n        text: `*Summary:*\\n${alert.summary}`\n      }\n    },\n    {\n      type: \"context\",\n      elements: [\n        {\n          type: \"mrkdwn\",\n          text: `Fired at: ${alert.startsAt}`\n        }\n      ]\n    }\n  ]\n};\n\nreturn {\n  json: {\n    alert,\n    slackMessage\n  }\n};"
      },
      "id": "format-warning",
      "name": "Format Warning Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format log entry for info alerts\nconst alert = $input.item.json;\n\nconst logEntry = {\n  timestamp: new Date().toISOString(),\n  level: 'info',\n  alertName: alert.alertName,\n  status: alert.status,\n  severity: alert.severity,\n  cluster: alert.cluster,\n  summary: alert.summary,\n  startsAt: alert.startsAt,\n  labels: alert.labels\n};\n\nreturn {\n  json: {\n    alert,\n    logEntry\n  }\n};"
      },
      "id": "format-info",
      "name": "Format Info Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL || 'https://hooks.slack.com/services/YOUR/WEBHOOK/URL' }}",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.slackMessage) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-slack-critical",
      "name": "Send to Slack (Critical)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 100],
      "notes": "Configure SLACK_WEBHOOK_URL environment variable",
      "notesInFlow": true
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.ALERT_FROM_EMAIL || 'alerts@cortex.local' }}",
        "toEmail": "={{ $env.ALERT_TO_EMAIL || 'oncall@cortex.local' }}",
        "subject": "={{ $json.emailSubject }}",
        "emailFormat": "text",
        "text": "={{ $json.emailContent }}",
        "options": {}
      },
      "id": "send-email-critical",
      "name": "Send Email (Critical)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1050, 200],
      "credentials": {
