{
  "name": "Alertmanager Webhook Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alertmanager",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "alertmanager-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Parse Alertmanager webhook payload\nconst payload = $input.item.json.body;\nconst alerts = payload.alerts || [];\n\n// Process each alert\nconst processedAlerts = alerts.map(alert => {\n  return {\n    alertname: alert.labels?.alertname || 'Unknown',\n    severity: alert.labels?.severity || 'info',\n    service: alert.labels?.service || alert.labels?.job || 'unknown',\n    instance: alert.labels?.instance || 'unknown',\n    namespace: alert.labels?.namespace || 'default',\n    status: alert.status || 'firing',\n    startsAt: alert.startsAt,\n    endsAt: alert.endsAt,\n    summary: alert.annotations?.summary || '',\n    description: alert.annotations?.description || '',\n    fingerprint: alert.fingerprint || '',\n    generatorURL: alert.generatorURL || '',\n    // Create deduplication key\n    dedupKey: `${alert.labels?.alertname}-${alert.labels?.service}-${alert.labels?.instance}`,\n    // Group key for alert grouping\n    groupKey: `${alert.labels?.alertname}-${alert.labels?.service}`,\n    rawAlert: alert\n  };\n});\n\nreturn processedAlerts.map(alert => ({ json: alert }));"
      },
      "id": "parse-payload",
      "name": "Parse Alertmanager Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.severity }}",
              "rightValue": "critical",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "route-critical",
      "name": "Route Critical",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.severity }}",
              "rightValue": "warning",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "route-warning",
      "name": "Route Warning",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 400]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge-routes",
      "name": "Merge Routes",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [850, 500]
    },
    {
      "parameters": {
        "jsCode": "// Deduplication logic using in-memory cache simulation\n// In production, use Redis or database\nconst alert = $input.item.json;\nconst dedupKey = alert.dedupKey;\nconst currentTime = new Date().getTime();\n\n// Check if alert was seen in last 5 minutes\n// This is a placeholder - implement actual dedup storage\nconst isDuplicate = false; // Replace with actual dedup check\n\nif (isDuplicate) {\n  return [];\n}\n\nreturn [{\n  json: {\n    ...alert,\n    deduped: true,\n    dedupTimestamp: currentTime\n  }\n}];"
      },
      "id": "deduplication",
      "name": "Deduplication",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 500]
    },
    {
      "parameters": {
        "jsCode": "// Group alerts by alertname and service\nconst alerts = $input.all();\nconst grouped = {};\n\nalerts.forEach(item => {\n  const alert = item.json;\n  const groupKey = alert.groupKey;\n  \n  if (!grouped[groupKey]) {\n    grouped[groupKey] = {\n      groupKey: groupKey,\n      alertname: alert.alertname,\n      service: alert.service,\n      severity: alert.severity,\n      count: 0,\n      instances: [],\n      alerts: []\n    };\n  }\n  \n  grouped[groupKey].count++;\n  grouped[groupKey].instances.push(alert.instance);\n  grouped[groupKey].alerts.push(alert);\n  \n  // Escalate severity if any critical\n  if (alert.severity === 'critical') {\n    grouped[groupKey].severity = 'critical';\n  }\n});\n\nreturn Object.values(grouped).map(group => ({ json: group }));"
      },
      "id": "group-alerts",
      "name": "Group Alerts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 500]
    },
    {
