        "emailFormat": "html",
        "text": "=<html>\n<body>\n<h2 style=\"color: #d32f2f;\">🚨 Critical Alert</h2>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Alert Name:</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.alertname }}</td></tr>\n<tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Severity:</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.severity }}</td></tr>\n<tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Service:</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.service }}</td></tr>\n<tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Instance:</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.instance }}</td></tr>\n<tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Namespace:</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.namespace }}</td></tr>\n</table>\n<h3>Summary</h3>\n<p>{{ $json.summary }}</p>\n<h3>Description</h3>\n<p>{{ $json.description }}</p>\n<p><a href=\"{{ $json.generatorURL }}\">View in Prometheus</a></p>\n</body>\n</html>",
        "options": {}
      },
