              "name": "text",
              "value": "=🚨 CRITICAL ALERT: {{ $json.alertname }}"
            },
            {
              "name": "blocks",
              "value": "=[{\"type\":\"header\",\"text\":{\"type\":\"plain_text\",\"text\":\"🚨 Critical Alert: {{ $json.alertname }}\"}},{\"type\":\"section\",\"fields\":[{\"type\":\"mrkdwn\",\"text\":\"*Service:*\\n{{ $json.service }}\"},{\"type\":\"mrkdwn\",\"text\":\"*Severity:*\\n{{ $json.severity }}\"},{\"type\":\"mrkdwn\",\"text\":\"*Instance:*\\n{{ $json.instance }}\"},{\"type\":\"mrkdwn\",\"text\":\"*Namespace:*\\n{{ $json.namespace }}\"}]},{\"type\":\"section\",\"text\":{\"type\":\"mrkdwn\",\"text\":\"*Summary:*\\n{{ $json.summary }}\\n\\n*Description:*\\n{{ $json.description }}\"}},{\"type\":\"section\",\"text\":{\"type\":\"mrkdwn\",\"text\":\"<{{ $json.generatorURL }}|View in Prometheus>\"}}]"
            }
          ]
        },
        "options": {}
      },
