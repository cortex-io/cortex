    {
      "parameters": {
        "jsCode": "// Capture execution result\nconst previousNode = $input.first();\nconst alert = previousNode.json;\nconst executionOutput = $input.item.json;\n\nreturn {\n  json: {\n    ...alert,\n    result: 'executed',\n    executionOutput,\n    completedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "capture-result",
      "name": "Capture Execution Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
