      "parameters": {
        "jsCode": "// Log dry-run action\nconst alert = $input.item.json;\n\nreturn {\n  json: {\n    ...alert,\n    result: 'dry_run_skipped',\n    message: `[DRY-RUN] Would execute: ${alert.remediation.command}`\n  }\n};"
      },
      "id": "log-dry-run",
      "name": "Log Dry-Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300]
