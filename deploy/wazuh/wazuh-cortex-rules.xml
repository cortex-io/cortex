<!--
  Wazuh Custom Rules for Cortex Security Monitoring
  Rule ID Range: 100100-100199
  Last Updated: 2025-12-11
-->

<group name="cortex,security,">

  <!-- ========================================
       Cortex Authentication & Access Control
       Rule IDs: 100100-100109
       ======================================== -->

  <rule id="100100" level="0">
    <decoded_as>cortex-json</decoded_as>
    <description>Cortex authentication event base rule</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="event_type">authentication_failed</field>
    <description>Cortex: Failed authentication attempt</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100102" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100101</if_matched_sid>
    <same_source_ip/>
    <description>Cortex: Multiple failed authentication attempts from same IP</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100103" level="12" frequency="10" timeframe="600">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>username</same_field>
    <description>Cortex: Brute force attack detected - multiple failed logins for same user</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100104" level="8">
    <if_sid>100100</if_sid>
    <field name="event_type">authentication_success</field>
    <field name="source_location">!^(10\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|192\.168\.)</field>
    <description>Cortex: Successful authentication from external IP address</description>
    <group>authentication_success,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100105" level="10">
    <if_sid>100100</if_sid>
    <field name="event_type">authentication_success</field>
    <time>00:00-06:00</time>
    <description>Cortex: Successful authentication during off-hours (00:00-06:00)</description>
    <group>authentication_success,off_hours,pci_dss_10.6.1,</group>
  </rule>

  <!-- ========================================
       Privilege Escalation Detection
       Rule IDs: 100110-100119
       ======================================== -->

  <rule id="100110" level="0">
    <decoded_as>cortex-json</decoded_as>
    <field name="component">meta-agent|master|coordinator</field>
    <description>Cortex privileged component base rule</description>
  </rule>

  <rule id="100111" level="12">
    <if_sid>100110</if_sid>
    <field name="event_type">privilege_escalation</field>
    <description>Cortex: Privilege escalation attempt detected</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,pci_dss_10.2.2,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100112" level="10">
    <if_sid>100110</if_sid>
    <field name="event_type">role_change</field>
    <field name="new_role">admin|root|coordinator</field>
    <description>Cortex: User role elevated to administrative level</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
    <group>privilege_escalation,pci_dss_10.2.2,</group>
  </rule>

  <rule id="100113" level="8">
    <if_sid>100110</if_sid>
    <field name="action">sudo|su|escalate</field>
    <description>Cortex: Sudo or privilege escalation command executed</description>
    <group>privilege_escalation,pci_dss_10.2.2,</group>
  </rule>

  <rule id="100114" level="15">
    <if_sid>100111</if_sid>
    <field name="user">worker|contractor|guest</field>
    <description>Cortex: CRITICAL - Non-privileged user attempting privilege escalation</description>
    <mitre>
      <id>T1068</id>
      <id>T1548</id>
    </mitre>
    <group>privilege_escalation,critical,pci_dss_10.2.2,gdpr_IV_35.7.d,</group>
  </rule>

  <!-- ========================================
       Configuration Change Monitoring
       Rule IDs: 100120-100129
       ======================================== -->

  <rule id="100120" level="0">
    <decoded_as>cortex-json</decoded_as>
    <field name="event_type">config_change</field>
    <description>Cortex configuration change base rule</description>
  </rule>

  <rule id="100121" level="8">
    <if_sid>100120</if_sid>
    <field name="config_file">/etc/cortex/|coordination/masters/</field>
    <description>Cortex: Configuration file modified</description>
    <group>config_change,pci_dss_10.5.5,gdpr_IV_32.2,</group>
  </rule>

  <rule id="100122" level="12">
    <if_sid>100120</if_sid>
    <field name="config_file">/etc/cortex/secrets|credentials|api-keys</field>
    <description>Cortex: CRITICAL - Secrets or credentials configuration modified</description>
    <mitre>
      <id>T1552.001</id>
    </mitre>
    <group>config_change,secrets,critical,pci_dss_10.5.5,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100123" level="10">
    <if_sid>100120</if_sid>
    <field name="config_file">master-state.json|worker-registry.json</field>
    <description>Cortex: Master or worker state configuration modified</description>
    <group>config_change,state_change,pci_dss_10.5.5,</group>
  </rule>

  <rule id="100124" level="6">
    <if_sid>100120</if_sid>
    <field name="change_type">delete|removed</field>
    <description>Cortex: Configuration file deleted</description>
    <group>config_change,file_deletion,pci_dss_10.5.5,</group>
  </rule>

  <!-- ========================================
       Suspicious API Activity
       Rule IDs: 100130-100139
       ======================================== -->

  <rule id="100130" level="0">
    <decoded_as>cortex-json</decoded_as>
    <field name="component">api|mcp-server</field>
    <description>Cortex API activity base rule</description>
  </rule>

  <rule id="100131" level="8">
    <if_sid>100130</if_sid>
    <field name="api_method">DELETE|PUT|PATCH</field>
    <field name="api_endpoint">*/delete|*/destroy|*/remove</field>
    <description>Cortex: Destructive API call detected</description>
    <group>api_abuse,pci_dss_10.2.7,</group>
  </rule>

  <rule id="100132" level="10" frequency="20" timeframe="60">
    <if_matched_sid>100130</if_matched_sid>
    <same_source_ip/>
    <description>Cortex: High API request rate from single source (possible DoS)</description>
    <mitre>
      <id>T1498</id>
    </mitre>
    <group>api_abuse,dos,pci_dss_11.4,</group>
  </rule>

  <rule id="100133" level="12">
    <if_sid>100130</if_sid>
    <field name="http_status">^40[1-3]$</field>
    <match>token|api_key|credential</match>
    <description>Cortex: Unauthorized API access with credentials in request</description>
    <mitre>
      <id>T1552.001</id>
    </mitre>
    <group>api_abuse,credential_exposure,pci_dss_10.2.4,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100134" level="7" frequency="10" timeframe="300">
    <if_matched_sid>100130</if_matched_sid>
    <field name="http_status">^50[0-9]$</field>
    <description>Cortex: High rate of API server errors (possible service degradation)</description>
    <group>api_errors,service_degradation,</group>
  </rule>

  <rule id="100135" level="10">
    <if_sid>100130</if_sid>
    <field name="api_endpoint">*/spawn|*/execute|*/deploy</field>
    <field name="user_type">worker|contractor|external</field>
    <description>Cortex: Non-privileged user attempting privileged API operations</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>api_abuse,privilege_escalation,pci_dss_10.2.2,</group>
  </rule>

  <!-- ========================================
       Kubernetes Audit Events
       Rule IDs: 100140-100149
       ======================================== -->

  <rule id="100140" level="0">
    <decoded_as>k8s-audit</decoded_as>
    <field name="objectRef.namespace">cortex</field>
    <description>Kubernetes audit event for Cortex namespace</description>
  </rule>

  <rule id="100141" level="10">
    <if_sid>100140</if_sid>
    <field name="verb">delete</field>
    <field name="objectRef.resource">pods|deployments|services</field>
    <description>Cortex K8s: Critical resource deletion detected</description>
    <mitre>
      <id>T1485</id>
    </mitre>
    <group>k8s_audit,resource_deletion,pci_dss_10.2.7,</group>
  </rule>

  <rule id="100142" level="12">
    <if_sid>100140</if_sid>
    <field name="verb">create|update</field>
    <field name="objectRef.resource">secrets</field>
    <description>Cortex K8s: Secret resource modified</description>
    <mitre>
      <id>T1552.007</id>
    </mitre>
    <group>k8s_audit,secrets,pci_dss_10.5.5,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100143" level="8">
    <if_sid>100140</if_sid>
    <field name="verb">exec</field>
    <description>Cortex K8s: Container exec command executed</description>
    <mitre>
      <id>T1609</id>
    </mitre>
    <group>k8s_audit,container_exec,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100144" level="15">
    <if_sid>100140</if_sid>
    <field name="verb">create|update</field>
    <field name="objectRef.resource">clusterrolebindings|rolebindings</field>
    <field name="requestObject.roleRef.name">cluster-admin|admin</field>
    <description>Cortex K8s: CRITICAL - Admin role binding created/modified</description>
    <mitre>
      <id>T1078.001</id>
    </mitre>
    <group>k8s_audit,privilege_escalation,critical,pci_dss_10.2.2,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100145" level="10">
    <if_sid>100140</if_sid>
    <field name="user.username">system:anonymous|system:unauthenticated</field>
    <description>Cortex K8s: Unauthenticated access attempt to Kubernetes API</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>k8s_audit,authentication_failed,pci_dss_10.2.4,</group>
  </rule>

  <!-- ========================================
       Container Escape Detection
       Rule IDs: 100150-100159
       ======================================== -->

  <rule id="100150" level="0">
    <decoded_as>cortex-json</decoded_as>
    <field name="component">container|pod</field>
    <description>Container event base rule</description>
  </rule>

  <rule id="100151" level="15">
    <if_sid>100150</if_sid>
    <field name="event_type">mount_attempt</field>
    <match>/proc|/sys|/dev</match>
    <description>Cortex Container: CRITICAL - Suspicious mount attempt (possible container escape)</description>
    <mitre>
      <id>T1611</id>
    </mitre>
    <group>container_escape,critical,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100152" level="12">
    <if_sid>100150</if_sid>
    <field name="capability">CAP_SYS_ADMIN|CAP_SYS_MODULE|CAP_SYS_RAWIO</field>
    <description>Cortex Container: Dangerous capability granted to container</description>
    <mitre>
      <id>T1611</id>
    </mitre>
    <group>container_security,dangerous_capability,pci_dss_11.4,</group>
  </rule>

  <rule id="100153" level="15">
    <if_sid>100150</if_sid>
    <field name="privileged">true</field>
    <description>Cortex Container: CRITICAL - Privileged container created</description>
    <mitre>
      <id>T1611</id>
    </mitre>
    <group>container_security,privileged_container,critical,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100154" level="10">
    <if_sid>100150</if_sid>
    <field name="event_type">namespace_change</field>
    <match>pid|net|mnt|ipc|uts</match>
    <description>Cortex Container: Namespace manipulation detected</description>
    <mitre>
      <id>T1611</id>
    </mitre>
    <group>container_security,namespace_manipulation,pci_dss_11.4,</group>
  </rule>

  <rule id="100155" level="12">
    <if_sid>100150</if_sid>
    <field name="process_name">docker|kubectl|crictl|runc</field>
    <description>Cortex Container: Container runtime command executed inside container</description>
    <mitre>
      <id>T1610</id>
    </mitre>
    <group>container_security,runtime_abuse,pci_dss_11.4,</group>
  </rule>

  <!-- ========================================
       Secrets & Credential Access
       Rule IDs: 100160-100169
       ======================================== -->

  <rule id="100160" level="0">
    <decoded_as>cortex-json</decoded_as>
    <description>Cortex secrets access base rule</description>
  </rule>

  <rule id="100161" level="12">
    <if_sid>100160</if_sid>
    <field name="event_type">secret_access</field>
    <field name="secret_type">api_key|token|password|credential</field>
    <description>Cortex: Secret or credential accessed</description>
    <mitre>
      <id>T1552.001</id>
    </mitre>
    <group>secrets_access,pci_dss_10.2.2,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100162" level="15">
    <if_sid>100161</if_sid>
    <field name="user_type">worker|contractor|external</field>
    <description>Cortex: CRITICAL - Non-privileged user accessed secrets</description>
    <mitre>
      <id>T1552.001</id>
    </mitre>
    <group>secrets_access,unauthorized_access,critical,pci_dss_10.2.2,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100163" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100161</if_matched_sid>
    <same_source_ip/>
    <description>Cortex: Multiple secret access attempts from same source</description>
    <mitre>
      <id>T1552</id>
    </mitre>
    <group>secrets_access,enumeration,pci_dss_10.2.2,</group>
  </rule>

  <rule id="100164" level="8">
    <if_sid>100160</if_sid>
    <field name="event_type">secret_export|secret_download</field>
    <description>Cortex: Secret exported or downloaded</description>
    <mitre>
      <id>T1552.001</id>
      <id>T1005</id>
    </mitre>
    <group>secrets_access,data_exfiltration,pci_dss_10.2.2,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100165" level="12">
    <if_sid>100160</if_sid>
    <match>BEGIN RSA PRIVATE KEY|BEGIN PRIVATE KEY|BEGIN OPENSSH PRIVATE KEY</match>
    <description>Cortex: Private key detected in logs or data stream</description>
    <mitre>
      <id>T1552.004</id>
    </mitre>
    <group>secrets_exposure,credential_exposure,pci_dss_10.2.2,gdpr_IV_35.7.d,</group>
  </rule>

  <!-- ========================================
       Task & Worker Anomalies
       Rule IDs: 100170-100179
       ======================================== -->

  <rule id="100170" level="0">
    <decoded_as>cortex-json</decoded_as>
    <field name="component">worker|task|master</field>
    <description>Cortex task execution base rule</description>
  </rule>

  <rule id="100171" level="8">
    <if_sid>100170</if_sid>
    <field name="task_status">failed</field>
    <field name="error_type">permission_denied|unauthorized</field>
    <description>Cortex: Task failed due to permission issues</description>
    <group>task_failure,permission_denied,pci_dss_10.2.4,</group>
  </rule>

  <rule id="100172" level="10" frequency="10" timeframe="600">
    <if_matched_sid>100171</if_matched_sid>
    <same_field>worker_id</same_field>
    <description>Cortex: Worker experiencing repeated permission failures</description>
    <group>task_failure,misconfiguration,pci_dss_10.6.1,</group>
  </rule>

  <rule id="100173" level="12">
    <if_sid>100170</if_sid>
    <field name="token_consumption">^([2-9][0-9]{4,}|[1-9][0-9]{5,})$</field>
    <description>Cortex: Abnormally high token consumption detected (>20k tokens)</description>
    <group>resource_abuse,token_abuse,</group>
  </rule>

  <rule id="100174" level="8">
    <if_sid>100170</if_sid>
    <field name="task_duration">^([3-9][0-9]{3,}|[1-9][0-9]{4,})$</field>
    <description>Cortex: Task running for excessive time (>3600 seconds)</description>
    <group>task_anomaly,long_running_task,</group>
  </rule>

  <rule id="100175" level="10">
    <if_sid>100170</if_sid>
    <field name="event_type">worker_spawn</field>
    <field name="spawned_by">worker|contractor</field>
    <description>Cortex: Worker spawned by non-master component (policy violation)</description>
    <mitre>
      <id>T1204</id>
    </mitre>
    <group>policy_violation,unauthorized_spawn,pci_dss_10.2.7,</group>
  </rule>

  <!-- ========================================
       Data Exfiltration & Network Anomalies
       Rule IDs: 100180-100189
       ======================================== -->

  <rule id="100180" level="0">
    <decoded_as>cortex-json</decoded_as>
    <field name="event_type">network_connection|data_transfer</field>
    <description>Cortex network activity base rule</description>
  </rule>

  <rule id="100181" level="12">
    <if_sid>100180</if_sid>
    <field name="destination">!^(10\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|192\.168\.)</field>
    <field name="bytes_transferred">^([1-9][0-9]{7,})$</field>
    <description>Cortex: Large data transfer to external IP (possible exfiltration)</description>
    <mitre>
      <id>T1041</id>
    </mitre>
    <group>data_exfiltration,network_anomaly,pci_dss_10.6.1,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100182" level="10">
    <if_sid>100180</if_sid>
    <field name="protocol">DNS</field>
    <field name="query_length">^([5-9][0-9]|[1-9][0-9]{2,})$</field>
    <description>Cortex: Suspiciously long DNS query (possible DNS tunneling)</description>
    <mitre>
      <id>T1572</id>
    </mitre>
    <group>dns_tunneling,network_anomaly,pci_dss_11.4,</group>
  </rule>

  <rule id="100183" level="8">
    <if_sid>100180</if_sid>
    <field name="destination_port">^(4444|5555|6666|7777|8888|9999|31337)$</field>
    <description>Cortex: Connection to suspicious port (common backdoor ports)</description>
    <mitre>
      <id>T1571</id>
    </mitre>
    <group>network_anomaly,suspicious_port,pci_dss_11.4,</group>
  </rule>

  <rule id="100184" level="15">
    <if_sid>100180</if_sid>
    <field name="destination">pastebin.com|transfer.sh|temp.sh|filebin.net</field>
    <description>Cortex: CRITICAL - Connection to file sharing service (possible data exfiltration)</description>
    <mitre>
      <id>T1567.002</id>
    </mitre>
    <group>data_exfiltration,file_sharing,critical,pci_dss_10.6.1,gdpr_IV_35.7.d,</group>
  </rule>

  <!-- ========================================
       System Integrity & Malware
       Rule IDs: 100190-100199
       ======================================== -->

  <rule id="100190" level="0">
    <decoded_as>cortex-json</decoded_as>
    <field name="event_type">file_integrity|malware_scan</field>
    <description>Cortex system integrity base rule</description>
  </rule>

  <rule id="100191" level="15">
    <if_sid>100190</if_sid>
    <field name="integrity_check">failed</field>
    <field name="file_path">/etc/cortex/|/usr/bin/cortex|coordination/masters/</field>
    <description>Cortex: CRITICAL - System file integrity check failed</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
    <group>integrity_violation,file_tampering,critical,pci_dss_11.5,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100192" level="15">
    <if_sid>100190</if_sid>
    <field name="malware_detected">true</field>
    <description>Cortex: CRITICAL - Malware detected</description>
    <mitre>
      <id>T1204</id>
    </mitre>
    <group>malware,critical,pci_dss_5.1,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100193" level="12">
    <if_sid>100190</if_sid>
    <match>nc -l|ncat -l|socat|/dev/tcp|bash -i</match>
    <description>Cortex: Reverse shell or backdoor command detected</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1071.001</id>
    </mitre>
    <group>backdoor,reverse_shell,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100194" level="10">
    <if_sid>100190</if_sid>
    <match>wget|curl.*\|.*sh|bash.*http|python.*-c.*http</match>
    <description>Cortex: Remote code execution pattern detected</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>remote_code_execution,pci_dss_11.4,</group>
  </rule>

  <rule id="100195" level="12">
    <if_sid>100190</if_sid>
    <field name="process_name">cryptominer|xmrig|minergate</field>
    <description>Cortex: Cryptocurrency miner process detected</description>
    <mitre>
      <id>T1496</id>
    </mitre>
    <group>cryptomining,resource_abuse,pci_dss_11.4,</group>
  </rule>

</group>
