<!--
  Wazuh Custom Decoders for Cortex Log Parsing
  Last Updated: 2025-12-11
-->

<decoder name="cortex-json">
  <prematch>^\s*{.*"component":</prematch>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<!-- ========================================
     Cortex Agent Log Decoder
     Matches: JSON logs from Cortex agents (meta, masters, workers, contractors)
     ======================================== -->

<decoder name="cortex-agent">
  <parent>cortex-json</parent>
  <use_own_name>true</use_own_name>
  <plugin_decoder offset="after_parent">JSON_Decoder</plugin_decoder>
  <field name="component">meta-agent|master|worker|contractor</field>
</decoder>

<decoder name="cortex-agent-metadata">
  <parent>cortex-agent</parent>
  <use_own_name>true</use_own_name>
  <plugin_decoder offset="after_parent">JSON_Decoder</plugin_decoder>
  <field name="timestamp" />
  <field name="level" />
  <field name="message" />
  <field name="agent_id" />
  <field name="session_id" />
</decoder>

<!-- ========================================
     Cortex Task Execution Log Decoder
     Matches: Task lifecycle events
     ======================================== -->

<decoder name="cortex-task">
  <parent>cortex-json</parent>
  <use_own_name>true</use_own_name>
  <plugin_decoder offset="after_parent">JSON_Decoder</plugin_decoder>
  <field name="event_type">task_started|task_completed|task_failed|task_spawned</field>
</decoder>

<decoder name="cortex-task-details">
  <parent>cortex-task</parent>
  <use_own_name>true</use_own_name>
  <plugin_decoder offset="after_parent">JSON_Decoder</plugin_decoder>
  <field name="task_id" />
  <field name="task_type" />
  <field name="task_status" />
  <field name="parent_master" />
  <field name="worker_id" />
  <field name="task_duration" />
  <field name="token_consumption" />
  <field name="error_message" />
</decoder>

