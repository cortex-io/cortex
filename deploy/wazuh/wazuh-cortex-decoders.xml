<!-- ========================================
     Kubernetes Audit Log Decoder
     Matches: k8s audit events for Cortex namespace
     ======================================== -->

<decoder name="k8s-audit">
  <prematch>^\s*{.*"kind":"Event".*"apiVersion":"audit.k8s.io</prematch>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<decoder name="k8s-audit-cortex">
  <parent>k8s-audit</parent>
  <use_own_name>true</use_own_name>
  <plugin_decoder offset="after_parent">JSON_Decoder</plugin_decoder>
  <field name="objectRef.namespace">cortex</field>
</decoder>

<decoder name="k8s-audit-details">
  <parent>k8s-audit-cortex</parent>
  <use_own_name>true</use_own_name>
  <plugin_decoder offset="after_parent">JSON_Decoder</plugin_decoder>
  <field name="verb" />
  <field name="objectRef.resource" />
  <field name="objectRef.name" />
  <field name="user.username" />
  <field name="user.groups" />
  <field name="sourceIPs" />
  <field name="userAgent" />
  <field name="responseStatus.code" />
  <field name="responseStatus.reason" />
</decoder>

