{
  "title": "UniFi Network Security - Syslog Events",
  "description": "Real-time monitoring of UniFi network devices and events",
  "version": 1,
  "timeRestore": false,
  "refreshInterval": {
    "pause": false,
    "value": 30000
  },
  "panels": [
    {
      "title": "Total UniFi Events (24h)",
      "type": "metric",
      "gridData": {"x": 0, "y": 0, "w": 6, "h": 4},
      "query": {
        "query": "syslog.hostname:(Dream-Machine* OR U6* OR U7* OR USW*) OR data.srcip:10.88.140.*",
        "language": "kuery"
      },
      "aggregation": {
        "type": "count"
      }
    },
    {
      "title": "Active UniFi Devices",
      "type": "metric",
      "gridData": {"x": 6, "y": 0, "w": 6, "h": 4},
      "query": {
        "query": "syslog.hostname:(Dream-Machine* OR U6* OR U7* OR USW*)",
        "language": "kuery"
      },
      "aggregation": {
        "type": "cardinality",
        "field": "syslog.hostname"
      }
    },
    {
      "title": "Client Connections (24h)",
      "type": "metric",
      "gridData": {"x": 12, "y": 0, "w": 6, "h": 4},
      "query": {
        "query": "data.message:(*STA_LEAVE* OR *STA_JOIN* OR *ASSOC* OR *DISASSOC*)",
        "language": "kuery"
      },
      "aggregation": {
        "type": "count"
      }
    },
    {
      "title": "Security Alerts",
      "type": "metric",
      "gridData": {"x": 18, "y": 0, "w": 6, "h": 4},
      "query": {
        "query": "(syslog.hostname:Dream-Machine* OR U6* OR U7*) AND rule.level:[8 TO 15]",
        "language": "kuery"
      },
      "aggregation": {
        "type": "count"
      }
    },
    {
      "title": "UniFi Network Events Timeline",
      "type": "area",
      "gridData": {"x": 0, "y": 4, "w": 24, "h": 6},
      "query": {
        "query": "syslog.hostname:(Dream-Machine* OR U6* OR U7* OR USW*)",
        "language": "kuery"
      },
      "aggregation": {
        "type": "date_histogram",
        "field": "@timestamp",
        "interval": "auto"
      },
      "breakdown": {
        "field": "syslog.hostname"
      }
    },
    {
      "title": "Events by Device Type",
      "type": "pie",
      "gridData": {"x": 0, "y": 10, "w": 8, "h": 6},
      "query": {
        "query": "syslog.hostname:(Dream-Machine* OR U6* OR U7* OR USW*)",
        "language": "kuery"
      },
      "aggregation": {
        "type": "terms",
        "field": "syslog.hostname",
        "size": 10
      }
    },
    {
      "title": "Top Event Types",
      "type": "pie",
      "gridData": {"x": 8, "y": 10, "w": 8, "h": 6},
      "query": {
        "query": "syslog.hostname:(Dream-Machine* OR U6* OR U7* OR USW*)",
        "language": "kuery"
      },
      "aggregation": {
        "type": "terms",
        "field": "syslog.program",
        "size": 10
      }
    },
    {
      "title": "Network Services",
      "type": "pie",
      "gridData": {"x": 16, "y": 10, "w": 8, "h": 6},
      "query": {
        "query": "syslog.hostname:Dream-Machine*",
        "language": "kuery"
      },
      "aggregation": {
        "type": "terms",
        "field": "data.program",
        "size": 10
      }
    },
    {
      "title": "UDM Pro - System Events",
      "type": "table",
      "gridData": {"x": 0, "y": 16, "w": 12, "h": 6},
      "query": {
        "query": "syslog.hostname:Dream-Machine-Pro",
        "language": "kuery"
      },
      "columns": [
        {"field": "@timestamp", "label": "Time"},
        {"field": "syslog.program", "label": "Service"},
        {"field": "data.message", "label": "Event"},
        {"field": "rule.level", "label": "Severity"}
      ],
      "sort": [{"field": "@timestamp", "direction": "desc"}]
    },
    {
      "title": "Access Points - Wireless Events",
      "type": "table",
      "gridData": {"x": 12, "y": 16, "w": 12, "h": 6},
      "query": {
        "query": "syslog.hostname:(U6* OR U7*)",
        "language": "kuery"
      },
      "columns": [
        {"field": "@timestamp", "label": "Time"},
        {"field": "syslog.hostname", "label": "AP"},
        {"field": "data.message", "label": "Event"}
      ],
      "sort": [{"field": "@timestamp", "direction": "desc"}]
    },
    {
      "title": "Client Disconnection Events",
      "type": "table",
      "gridData": {"x": 0, "y": 22, "w": 12, "h": 6},
      "query": {
        "query": "data.message:(*STA_LEAVE* OR *disassoc* OR *DEAUTH*)",
        "language": "kuery"
      },
      "columns": [
        {"field": "@timestamp", "label": "Time"},
        {"field": "syslog.hostname", "label": "Device"},
        {"field": "data.message", "label": "Details"}
      ],
      "sort": [{"field": "@timestamp", "direction": "desc"}]
    },
    {
      "title": "DHCP & DNS Activity",
      "type": "table",
      "gridData": {"x": 12, "y": 22, "w": 12, "h": 6},
      "query": {
        "query": "syslog.program:(dnsmasq OR dhcpd)",
        "language": "kuery"
      },
      "columns": [
        {"field": "@timestamp", "label": "Time"},
        {"field": "syslog.program", "label": "Service"},
        {"field": "data.message", "label": "Activity"}
      ],
      "sort": [{"field": "@timestamp", "direction": "desc"}]
    },
    {
      "title": "BGP Routing Events",
      "type": "table",
      "gridData": {"x": 0, "y": 28, "w": 12, "h": 6},
      "query": {
        "query": "syslog.hostname:Dream-Machine-Pro AND syslog.program:bgpd",
        "language": "kuery"
      },
      "columns": [
        {"field": "@timestamp", "label": "Time"},
        {"field": "data.message", "label": "BGP Event"}
      ],
      "sort": [{"field": "@timestamp", "direction": "desc"}]
    },
    {
      "title": "Security & Authentication Events",
      "type": "table",
      "gridData": {"x": 12, "y": 28, "w": 12, "h": 6},
      "query": {
        "query": "(data.message:*WPA* OR *auth* OR *security*) AND syslog.hostname:(U6* OR U7* OR Dream-Machine*)",
        "language": "kuery"
      },
      "columns": [
        {"field": "@timestamp", "label": "Time"},
        {"field": "syslog.hostname", "label": "Device"},
        {"field": "data.message", "label": "Security Event"},
        {"field": "rule.level", "label": "Severity"}
      ],
      "sort": [{"field": "@timestamp", "direction": "desc"}]
    },
    {
      "title": "All UniFi Events - Recent",
      "type": "table",
      "gridData": {"x": 0, "y": 34, "w": 24, "h": 8},
      "query": {
        "query": "syslog.hostname:(Dream-Machine* OR U6* OR U7* OR USW*) OR data.srcip:10.88.140.*",
        "language": "kuery"
      },
      "columns": [
        {"field": "@timestamp", "label": "Time"},
        {"field": "syslog.hostname", "label": "Device"},
        {"field": "syslog.program", "label": "Program"},
        {"field": "data.message", "label": "Message"},
        {"field": "rule.level", "label": "Level"}
      ],
      "sort": [{"field": "@timestamp", "direction": "desc"}],
      "pageSize": 25
    }
  ]
}