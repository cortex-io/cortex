{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.dev/schemas/feature-list.json",
  "title": "Cortex Feature List",
  "description": "Schema for task feature decomposition lists",
  "type": "object",
  "required": ["task_id", "total_features", "completed", "created_at", "features"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task-[a-z0-9-]+$",
      "description": "Unique task identifier"
    },
    "master": {
      "type": "string",
      "enum": [
        "initializer-master",
        "development-master",
        "security-master",
        "inventory-master",
        "cicd-master",
        "coordinator-master"
      ],
      "description": "Master agent responsible for this task"
    },
    "total_features": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of features in the list"
    },
    "completed": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of completed (passing) features"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of feature list creation"
    },
    "created_by": {
      "type": "string",
      "description": "Agent that created this feature list"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/feature"
      }
    }
  },
  "definitions": {
    "feature": {
      "type": "object",
      "required": ["feature_id", "description", "status", "priority", "test_command"],
      "properties": {
        "feature_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+-[0-9]{3}$",
          "description": "Unique feature identifier (e.g., auth-001)"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "description": "Clear, specific description of the feature"
        },
        "status": {
          "type": "string",
          "enum": ["failing", "in_progress", "passing", "blocked"],
          "description": "Current implementation status"
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Implementation priority"
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 15,
          "description": "Estimated implementation time in minutes"
        },
        "test_command": {
          "type": "string",
          "minLength": 5,
          "description": "Command to run tests for this feature"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+-[0-9]{3}$"
          },
          "maxItems": 3,
          "description": "Feature IDs that must be completed first"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "List of criteria that must be met"
        },
        "assigned_to": {
          "type": ["string", "null"],
          "description": "Worker ID currently implementing this feature"
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp when feature was completed"
        },
        "test_results": {
          "type": ["object", "null"],
          "properties": {
            "exit_code": {
              "type": "integer"
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            },
            "duration_ms": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
